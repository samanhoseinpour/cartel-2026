{% comment %}
  Cartel contact — full .ct-hero band from Contact.dc.html (lane 7E rewrite of
  Dawn's contact-form): intro + channel links on the left, the real Shopify
  contact form card on the right. Success replaces the card; errors render
  in-card above the fields. Email + phone live in section settings; the mock's
  hello@cartellash.ca / (604) 555-0142 placeholders were replaced with the
  client's real details on 2026-08-10.
{% endcomment %}
<div class="cl">
  {%- if section.settings.show_breadcrumbs -%}
    <section class="wrap">{% render 'cartel-breadcrumbs' %}</section>
  {%- endif -%}

  {%- liquid
    assign contact_email = section.settings.contact_email
    assign contact_phone = section.settings.contact_phone
    assign phone_digits = contact_phone | remove: '(' | remove: ')' | remove: '-' | remove: ' ' | remove: '.'
    unless phone_digits contains '+'
      assign phone_digits = '+1' | append: phone_digits
    endunless
  -%}

  <section class="wrap">
    <div class="ct-hero">
      <div class="ct-intro">
        {%- if section.settings.eyebrow != blank -%}<span class="kick">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1 class="ct-h1">{{ section.settings.heading | default: page.title }}</h1>
        {%- if section.settings.lead != blank -%}<p class="ct-sub">{{ section.settings.lead }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="ct-channels">
            {%- for block in section.blocks -%}
              {%- if block.type == 'channel' -%}
                {%- liquid
                  assign ch_style = block.settings.style
                  assign ch_href = block.settings.url
                  assign ch_text = block.settings.text
                  if ch_style == 'email'
                    assign ch_href = 'mailto:' | append: contact_email
                    assign ch_text = contact_email
                  elsif ch_style == 'phone'
                    assign ch_href = 'tel:' | append: phone_digits
                    assign ch_text = contact_phone
                  endif
                -%}
                <a class="ct-ch" href="{{ ch_href }}"{% if ch_style == 'instagram' %} target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
                  <span class="ct-ch-ic">
                    {%- case ch_style -%}
                      {%- when 'instagram' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="5"></rect><circle cx="12" cy="12" r="3.6"></circle><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"></circle></svg>
                      {%- when 'phone' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg>
                      {%- when 'chat' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 5h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H9l-4 4V6a1 1 0 0 1 1-1z"></path></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.5"></rect><path d="M4 7.5l8 6 8-6"></path></svg>
                    {%- endcase -%}
                  </span>
                  <span class="ct-ch-b">
                    <b>{{ block.settings.title }}</b>
                    <span>{{ ch_text }}</span>
                  </span>
                  <svg class="ct-ch-arr" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="ct-formwrap">
        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="ct-card ct-success">
              <div class="ct-success-ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
              </div>
              <h2 class="ct-card-h">{{ section.settings.success_heading }}</h2>
              <p class="ct-card-p">{{ section.settings.success_text }}</p>
              <div class="ct-success-row">
                {%- if section.settings.success_btn_label != blank -%}
                  <a class="btn btn-fill" href="{{ section.settings.success_btn_link | default: routes.all_products_collection_url }}">{{ section.settings.success_btn_label }}</a>
                {%- endif -%}
                <a class="btn btn-out" href="{{ page.url }}">{{ section.settings.success_again_label | default: 'Send another' }}</a>
              </div>
            </div>
          {%- else -%}
            <div class="ct-card">
              <h2 class="ct-card-h">{{ section.settings.form_heading }}</h2>
              {%- if section.settings.form_text != blank -%}<p class="ct-card-p">{{ section.settings.form_text }}</p>{%- endif -%}

              {%- if form.errors -%}
                <div class="ct-err" role="alert">
                  <b>{{ section.settings.error_heading | default: "That didn't send — check the details below." }}</b>
                  {%- for field in form.errors -%}
                    <span>
                      {%- if field == 'form' -%}
                        {{ form.errors.messages[field] }}
                      {%- else -%}
                        {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                      {%- endif -%}
                    </span>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              {%- assign has_topics = false -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'topic' -%}{%- assign has_topics = true -%}{%- endif -%}
              {%- endfor -%}
              {%- if has_topics -%}
                <div class="ct-topics">
                  <span class="ct-label">{{ section.settings.topics_label }}</span>
                  <div class="ct-chips">
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'topic' -%}
                        <button type="button" class="ct-chip" data-ct-topic aria-pressed="false" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

              <div class="ct-form">
                <input type="hidden" name="contact[Topic]" data-ct-topic-input value="">
                <div class="ct-row2">
                  <label class="ct-field">
                    <span class="ct-label">First name</span>
                    <input class="ct-input" type="text" name="contact[name]" value="{{ form.name }}" placeholder="Your name" autocomplete="given-name" required>
                  </label>
                  <label class="ct-field">
                    <span class="ct-label">Email</span>
                    <input class="ct-input" type="email" name="contact[email]" value="{{ form.email }}" placeholder="you@studio.com" autocomplete="email" required>
                  </label>
                </div>
                <label class="ct-field">
                  <span class="ct-label">Order number <i>(optional)</i></span>
                  <input class="ct-input" type="text" name="contact[Order number]" placeholder="#CL-00000">
                </label>
                <label class="ct-field">
                  <span class="ct-label">Message</span>
                  <textarea class="ct-textarea" name="contact[body]" placeholder="How can we help?" required>{{ form.body }}</textarea>
                </label>
                <button class="btn btn-fill w100 ct-send" type="submit">
                  {{- section.settings.submit_label -}}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
                </button>
                {%- if section.settings.fineprint != blank -%}
                  <p class="ct-fineprint">{{ section.settings.fineprint }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Cartel contact",
  "tag": "section",
  "class": "cartel-section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact us" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Get in <em>Touch</em>" },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph", "default": "A question about a product, your order, wholesale or training? We're lash artists too, drop us a line and a real human gets back to you, usually within one business day." },
    { "type": "header", "content": "Store contact details" },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email address",
      "info": "Confirmed by the client 2026-08-10. Also set on the footer contact block (footer-group.json) and the wholesale card on the contact page.",
      "default": "kireilashco@gmail.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone number",
      "info": "Confirmed by the client 2026-08-10. Use a plain ASCII hyphen — the tel: href is built by stripping ( ) - space, so a typographic hyphen would survive into the link and break it.",
      "default": "+1 (778) 251-5550"
    },
    { "type": "header", "content": "Form card" },
    { "type": "text", "id": "form_heading", "label": "Card heading", "default": "Send us a message" },
    { "type": "text", "id": "form_text", "label": "Card text", "default": "Tell us what you need and we'll be in touch." },
    { "type": "text", "id": "topics_label", "label": "Topics label", "default": "What's it about?" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Send message" },
    { "type": "inline_richtext", "id": "fineprint", "label": "Fine print", "default": "We'll only use your details to reply. See our <a href=\"/pages/privacy-policy\">privacy policy</a>." },
    { "type": "text", "id": "error_heading", "label": "Error heading", "default": "That didn't send — check the details below." },
    { "type": "header", "content": "Success state" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Message sent, thank you!" },
    { "type": "textarea", "id": "success_text", "label": "Success text", "default": "We've got your note and will reply within one business day. Keep an eye on your inbox (and the spam folder, just in case)." },
    { "type": "text", "id": "success_btn_label", "label": "Success button label", "default": "Keep shopping" },
    { "type": "url", "id": "success_btn_link", "label": "Success button link" },
    { "type": "text", "id": "success_again_label", "label": "Send-another label", "default": "Send another" }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Contact channel",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Type",
          "options": [
            { "value": "email", "label": "Email (uses section email)" },
            { "value": "phone", "label": "Phone (uses section phone)" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "chat", "label": "Custom link" }
          ],
          "default": "email"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Email us" },
        { "type": "text", "id": "text", "label": "Subtitle (Instagram / custom)", "default": "@cartel.lash" },
        { "type": "url", "id": "url", "label": "Link (Instagram / custom)" }
      ]
    },
    {
      "type": "topic",
      "name": "Topic chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Order help" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cartel contact",
      "blocks": [
        { "type": "channel", "settings": { "style": "email", "title": "Email us" } },
        { "type": "channel", "settings": { "style": "instagram", "title": "Slide into the DMs", "text": "@cartel.lash", "url": "https://www.instagram.com/cartel.lash/" } },
        { "type": "topic", "settings": { "label": "Order help" } },
        { "type": "topic", "settings": { "label": "Product question" } },
        { "type": "topic", "settings": { "label": "Wholesale & trade" } },
        { "type": "topic", "settings": { "label": "Training" } },
        { "type": "topic", "settings": { "label": "Something else" } }
      ]
    }
  ]
}
{% endschema %}
