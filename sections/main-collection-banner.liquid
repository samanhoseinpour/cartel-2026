{% comment %}
  Cartel collection header — batch 7A, 1:1 with Collection.dc.html (.collhead).
  Breadcrumbs come from the shared cartel-breadcrumbs snippet.
  Eyebrow: collection metafield custom.eyebrow, fallback "Shop all".
{% endcomment %}
{%- liquid
  assign eyebrow = collection.metafields.custom.eyebrow.value | default: 'Shop all'
  assign show_image = false
  if section.settings.show_collection_image and collection.image
    assign show_image = true
  endif
-%}
<div class="cl">
  <section class="wrap">{% render 'cartel-breadcrumbs' %}</section>
  <section class="wrap collhead">
    <div class="collhead-row{% if show_image %} has-img{% endif %}">
      <div class="collhead-l">
        <span class="kick">{{ eyebrow | escape }}</span>
        <h1 class="stitle collhead-t">{{ collection.title | escape }}</h1>
        {%- if section.settings.show_collection_description and collection.description != blank -%}
          <div class="lead collhead-p">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      {%- if show_image -%}
        <div class="collhead-img">
          {{ collection.image | image_url: width: 720 | image_tag: widths: '360,540,720', alt: collection.title }}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Collection header",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "Show collection description"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "Show collection image"
    }
  ]
}
{% endschema %}
