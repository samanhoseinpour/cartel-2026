{%- comment -%}
  Cartel Lash — order detail (lane 7D). Dawn's order data, Account.dc.html
  vocabulary: .ord line rows, .trow totals, .inforow address cards. All of
  Dawn's order fields are kept (variants, properties, selling plans, line
  discounts, fulfillment + tracking, shipping, tax, duties, refunds).
{%- endcomment -%}

{%- liquid
  if order.cancelled
    assign fulfill_class = 'st-proc'
  elsif order.fulfillment_status == 'fulfilled'
    assign fulfill_class = 'st-deliv'
  elsif order.fulfillment_status == 'partial'
    assign fulfill_class = 'st-transit'
  else
    assign fulfill_class = 'st-proc'
  endif
  if order.financial_status == 'paid'
    assign pay_class = 'st-deliv'
  elsif order.financial_status == 'pending' or order.financial_status == 'authorized' or order.financial_status == 'partially_paid'
    assign pay_class = 'st-transit'
  else
    assign pay_class = 'st-proc'
  endif
-%}

<div class="cl">
  <div class="page-width">
    <nav class="crumb" aria-label="Breadcrumb">
      <a class="crumb-a" href="{{ routes.root_url }}">Home</a>
      <span class="crumb-sep">/</span>
      <a class="crumb-a" href="{{ routes.account_url }}">Account</a>
      <span class="crumb-sep">/</span>
      <span class="crumb-cur">Order {{ order.name }}</span>
    </nav>
  </div>
  <section class="page-width acctpage">
    <div class="dash-top">
      <div>
        <h1 class="dash-hi">Order {{ order.name }}</h1>
        <p class="dash-sub">
          Placed {{ order.created_at | date: '%B %-d, %Y' }}
          {%- if order.cancelled %} · cancelled {{ order.cancelled_at | date: '%B %-d, %Y' }}{% endif %}
        </p>
      </div>
      <div class="dash-top-r">
        <span class="ord-status {{ fulfill_class }}">
          {%- if order.cancelled %}Cancelled{% else %}{{ order.fulfillment_status_label }}{% endif -%}
        </span>
        <a class="btn btn-out btn-sm" href="{{ routes.account_url }}">Back to orders</a>
      </div>
    </div>

    <div class="dashbody">
      <nav class="acctrail" aria-label="Account">
        <a class="arow on" href="{{ routes.account_url }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l8 4v10l-8 4-8-4V7z"></path><path d="M4 7l8 4 8-4"></path></svg>
          Orders
        </a>
        <a class="arow" href="{{ routes.account_addresses_url }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-6.5-5.3-6.5-10A6.5 6.5 0 0 1 18.5 11c0 4.7-6.5 10-6.5 10z"></path><circle cx="12" cy="11" r="2.4"></circle></svg>
          Addresses
        </a>
        <a class="arow" href="{{ routes.account_url }}#account-details">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 20.5c0-4 3.5-6.5 7.5-6.5s7.5 2.5 7.5 6.5"></path></svg>
          Account details
        </a>
        <span class="arow-sp"></span>
        <a class="arow danger" href="{{ routes.account_logout_url }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 12H4M9 7l-5 5 5 5"></path><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"></path></svg>
          Log out
        </a>
      </nav>

      <div class="panel">
        {%- if order.cancelled -%}
          <div class="form-alert" role="status">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5M12 16h.01"></path></svg>
            <div class="form-alert-b">
              This order was cancelled on {{ order.cancelled_at | date: '%B %-d, %Y' }}
              {%- if order.cancel_reason_label %} — reason: {{ order.cancel_reason_label | downcase }}{% endif %}.
            </div>
          </div>
        {%- endif -%}

        <div class="pcard">
          <div class="pcard-h">
            <span class="pcard-t">Items</span>
            <span class="pcard-link">{{ order.item_count }} item{% if order.item_count != 1 %}s{% endif %}</span>
          </div>
          <div class="pcard-b">
            {%- for line_item in order.line_items -%}
              <div class="ord{% if forloop.first %} first{% endif %}">
                <div class="ord-img">
                  {%- if line_item.image -%}
                    {{ line_item.image | image_url: width: 112 | image_tag: loading: 'lazy', alt: line_item.title }}
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l8 4v10l-8 4-8-4V7z"></path><path d="M4 7l8 4 8-4"></path></svg>
                  {%- endif -%}
                </div>
                <div class="ord-m">
                  {%- if line_item.url != blank -%}
                    <a class="ord-id" href="{{ line_item.url }}">{{ line_item.title | escape }}</a>
                  {%- else -%}
                    <span class="ord-id">{{ line_item.title | escape }}</span>
                  {%- endif -%}
                  <div class="ord-meta">
                    {%- unless line_item.product.has_only_default_variant -%}
                      {{ line_item.variant.title | escape }} ·
                    {%- endunless %}
                    {{ line_item.quantity }} ×
                    {%- if line_item.original_price != line_item.final_price %}
                      <s>{{ line_item.original_price | money }}</s>
                    {% endif %}
                    {{ line_item.final_price | money }}
                    {%- if line_item.sku != blank %} · SKU {{ line_item.sku }}{% endif %}
                  </div>
                  {%- if line_item.selling_plan_allocation -%}
                    <div class="ord-meta">{{ line_item.selling_plan_allocation.selling_plan.name }}</div>
                  {%- endif -%}
                  {%- for property in line_item.properties -%}
                    {%- assign property_first_char = property.first | slice: 0 -%}
                    {%- if property.last != blank and property_first_char != '_' -%}
                      <div class="ord-meta">
                        {{ property.first }}:
                        {%- if property.last contains '/uploads/' -%}
                          <a class="ord-track" href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                        {%- else -%}
                          {{ property.last }}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                    <div class="ord-meta">
                      {{ discount_allocation.discount_application.title | escape }}
                      (−{{ discount_allocation.amount | money }})
                    </div>
                  {%- endfor -%}
                  {%- if line_item.fulfillment -%}
                    <div class="ord-meta">
                      Fulfilled {{ line_item.fulfillment.created_at | date: '%b %-d, %Y' }}
                      {%- if line_item.fulfillment.tracking_company %} · {{ line_item.fulfillment.tracking_company }}{% endif %}
                      {%- if line_item.fulfillment.tracking_number %} #{{ line_item.fulfillment.tracking_number }}{% endif %}
                      {%- if line_item.fulfillment.tracking_url %}
                        · <a class="ord-track" href="{{ line_item.fulfillment.tracking_url }}">Track shipment</a>
                      {%- endif %}
                    </div>
                  {%- endif -%}
                </div>
                <span class="ord-total">
                  {%- if line_item.original_line_price != line_item.final_line_price -%}
                    <s>{{ line_item.original_line_price | money }}</s>
                  {%- endif %}
                  {{ line_item.final_line_price | money }}
                </span>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="pcard">
          <div class="pcard-h">
            <span class="pcard-t">Summary</span>
          </div>
          <div class="pcard-b">
            <div class="trow first">
              <span class="trow-l">Subtotal</span>
              <span class="trow-v">{{ order.line_items_subtotal_price | money }}</span>
            </div>
            {%- for discount_application in order.cart_level_discount_applications -%}
              <div class="trow">
                <span class="trow-l">Discount · {{ discount_application.title | escape }}</span>
                <span class="trow-v">−{{ discount_application.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
            {%- for shipping_method in order.shipping_methods -%}
              <div class="trow">
                <span class="trow-l">Shipping ({{ shipping_method.title | escape }})</span>
                <span class="trow-v">{{ shipping_method.price | money }}</span>
              </div>
            {%- endfor -%}
            {%- for tax_line in order.tax_lines -%}
              <div class="trow">
                <span class="trow-l">Tax · {{ tax_line.title | escape }} {{ tax_line.rate | times: 100 }}%</span>
                <span class="trow-v">{{ tax_line.price | money }}</span>
              </div>
            {%- endfor -%}
            {%- if order.total_duties -%}
              <div class="trow">
                <span class="trow-l">Duties</span>
                <span class="trow-v">{{ order.total_duties | money }}</span>
              </div>
            {%- endif -%}
            {%- if order.total_refunded_amount > 0 -%}
              <div class="trow">
                <span class="trow-l">Refunded</span>
                <span class="trow-v">−{{ order.total_refunded_amount | money }}</span>
              </div>
            {%- endif -%}
            <div class="trow total">
              <span class="trow-l">Total</span>
              <span class="trow-v">{{ order.total_net_amount | money_with_currency }}</span>
            </div>
          </div>
        </div>

        <div class="inforow">
          <div class="pcard">
            <div class="pcard-h">
              <span class="pcard-t">Billing</span>
              <span class="ord-status {{ pay_class }}">{{ order.financial_status_label }}</span>
            </div>
            <div class="pcard-b">
              <div class="addr-line">{{ order.billing_address | format_address }}</div>
            </div>
          </div>
          <div class="pcard">
            <div class="pcard-h">
              <span class="pcard-t">Shipping</span>
              <span class="ord-status {{ fulfill_class }}">
                {%- if order.cancelled %}Cancelled{% else %}{{ order.fulfillment_status_label }}{% endif -%}
              </span>
            </div>
            <div class="pcard-b">
              <div class="addr-line">{{ order.shipping_address | format_address }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "t:sections.main-order.name",
  "settings": []
}
{% endschema %}
