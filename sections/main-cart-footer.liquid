{% comment %}
  Cartel cart — functional stub (lane 7C).
  The whole cart page, including the order summary, renders in
  main-cart-items.liquid so the design's two-column grid can live in one
  section. cart.js still expects #main-cart-footer[data-id] with a
  .js-contents child in its section-rendering list, so this section stays
  in templates/cart.json but paints nothing.
{% endcomment %}

<div id="main-cart-footer" data-id="{{ section.id }}" hidden>
  <div class="js-contents"></div>
</div>

{% schema %}
{
  "name": "Cart summary (merged)",
  "settings": []
}
{% endschema %}
