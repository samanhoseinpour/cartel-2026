{% comment %}
  Cartel brands index — batch 7A, 1:1 with Brands.dc.html.
  Intro header + .bx-grid6 of brand cards. Cards come from section blocks
  (collection picker, client controls order); with no blocks it falls back to
  every collection on the store so the page is never blank.
{% endcomment %}
<div class="cl">
  <section class="wrap">{% render 'cartel-breadcrumbs' %}</section>

  <section class="wrap bx-head">
    <span class="bkick">{{ section.settings.eyebrow | escape }}</span>
    <h1 class="stitle bx-title">{{ section.settings.title | escape }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="bx-intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
  </section>

  <section class="wrap bpage">
    <div class="bx-grid6">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="bx-item" {{ block.shopify_attributes }}>
            {% render 'card-collection',
              card_collection: block.settings.collection,
              accent: block.settings.accent,
              badge: block.settings.badge,
              eyebrow: block.settings.eyebrow,
              blurb: block.settings.blurb,
              specs: block.settings.specs,
              card_image: block.settings.image
            %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for c in collections -%}
          {%- if c.handle == 'all' or c.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
          {%- capture accent -%}{% cycle 'bx-wine', 'bx-bronze', 'bx-blush', 'bx-mauve', 'bx-taupe', 'bx-sage' %}{%- endcapture -%}
          <div class="bx-item">
            {% render 'card-collection', card_collection: c, accent: accent %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Brands index",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by brand"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The pro lines we carry"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Every brand on the Cartel shelf is chosen for pro results and stocked authentic in Canada. Explore each line, or jump straight into a full brand page."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Brand collection" },
        {
          "type": "select",
          "id": "accent",
          "label": "Accent",
          "default": "bx-bronze",
          "options": [
            { "value": "bx-bronze", "label": "Bronze" },
            { "value": "bx-blush", "label": "Blush" },
            { "value": "bx-mauve", "label": "Mauve" },
            { "value": "bx-taupe", "label": "Taupe" },
            { "value": "bx-wine", "label": "Wine" },
            { "value": "bx-sage", "label": "Sage" }
          ]
        },
        { "type": "text", "id": "badge", "label": "Image badge", "info": "e.g. “Brow & lash tint”, “Sign in for pricing”." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "e.g. “Thuya · Spain”." },
        { "type": "textarea", "id": "blurb", "label": "Blurb", "info": "Blank = collection description." },
        { "type": "text", "id": "specs", "label": "Spec pills", "info": "Comma-separated, e.g. “Lash lift, Brow lamination, Vegan line”." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Blank = collection image." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cartel brands index"
    }
  ]
}
{% endschema %}
