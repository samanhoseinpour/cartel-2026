{% comment %}
  Cartel brand page bands — batch 7A, 1:1 with Brand.dc.html.
  One section, two modes (a JSON template can't split one section around the
  product grid, and this lane only owns this section file):
    - "hero"  : breadcrumbs + .btabs brand switcher + .bhead themed panel
                (logo lockup or wordmark, tagline, Thuya gate note) + .bchip row
    - "story" : .bwhy "why pros choose" band + .bfaq brand FAQ + .bcross cross-brand CTA
  collection.brand.json runs: hero → main-collection-product-grid → story.
 
  Collection metafields:
    custom.brand_logo (file)  — logo lockup, falls back to the wordmark
    custom.tagline (text)     — .bhead-tag, falls back to the description text
    custom.theme_key (text)   — bronsun|noemi|thuya|linger|cartel|prolong panel themes
    custom.gated (boolean)    — trade-line note (fallback: title is "Thuya")
    custom.why_1_title … custom.why_3_title (text) — why-band points; when
      why_1_title is set, the points come from metafields instead of the blocks
    custom.why_1_text … custom.why_3_text (text)   — why-band point copy
    custom.why_image (file)   — why-band image, falls back to the section image
    custom.faq_1_q / faq_1_a … faq_6_q / faq_6_a  — brand FAQ, rendered as
      <details> + FAQPage JSON-LD. Hidden when no questions are set.
{% endcomment %}
{%- liquid
  assign tk = collection.metafields.custom.theme_key.value | downcase | strip
  assign theme_class = ''
  case tk
    when 'bronsun', 'noemi', 'thuya', 'linger', 'cartel', 'prolong'
      assign theme_class = tk
  endcase
 
  # Test that the metafield EXISTS, not that it is truthy. `gated_mf != blank`
  # delegates blank? to the value, so a boolean set to false read as "not set"
  # and fell through to the title fallback — a collection called "Thuya" could
  # never be un-gated from the metafield. `.type` is only ever nil when the
  # definition/value is absent.
  assign gated_mf = collection.metafields.custom.gated
  assign gated = false
  if gated_mf.type != blank
    assign gated = gated_mf.value
  elsif collection.title == 'Thuya'
    assign gated = true
  endif
-%}
 
{%- if section.settings.mode == 'hero' -%}
  {%- liquid
    assign logo = collection.metafields.custom.brand_logo.value
    # Escape the plain-text metafield here; do NOT escape the description
    # fallback. strip_html removes tags but leaves entities encoded, so escaping
    # it again turned "lash &amp; brow" into a literal "&amp;" on screen. Same
    # split card-collection.liquid documents.
    assign tagline_mf = collection.metafields.custom.tagline.value
    if tagline_mf != blank
      assign tagline = tagline_mf | escape
    else
      assign tagline = collection.description | strip_html | truncate: 180
    endif
 
    assign tab_count = 0
    assign chip_count = 0
    for block in section.blocks
      if block.type == 'tab' or block.type == 'tab_soon'
        assign tab_count = tab_count | plus: 1
      elsif block.type == 'chip'
        assign chip_count = chip_count | plus: 1
      endif
    endfor
  -%}
  <div class="cl">
    <section class="wrap">{% render 'cartel-breadcrumbs' %}</section>
 
    {%- if tab_count > 0 -%}
      <section class="wrap btabs-wrap">
        <div class="btabs">
          <span class="btabs-l">{{ section.settings.tabs_label | escape }}</span>
          <div class="btabs-pills">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'tab' -%}
                  {%- liquid
                    assign tab_c = block.settings.collection
                    assign tab_label = block.settings.label | default: tab_c.title
                  -%}
                  {%- if tab_c != blank -%}
                    <a
                      class="btab{% if tab_c.handle == collection.handle %} on{% endif %}"
                      href="{{ tab_c.url }}"
                      {{ block.shopify_attributes }}
                    >{{ tab_label | escape }}</a>
                  {%- endif -%}
                {%- when 'tab_soon' -%}
                  <span class="btab btab-soon" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</span>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}
 
    <section class="wrap">
      <div class="bhead {{ theme_class }}">
        {%- if logo -%}
          <h1 class="bhead-lockup">
            {{ logo | image_url: width: 640 | image_tag: class: 'bhead-logo', alt: collection.title }}
          </h1>
        {%- else -%}
          <h1 class="bhead-name">{{ collection.title | escape }}</h1>
        {%- endif -%}
        {%- if tagline != blank -%}
          <p class="bhead-tag">{{ tagline }}</p>
        {%- endif -%}
        {%- if gated and customer == nil -%}
          <span class="bhead-gate">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.6"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
            Trade line, log in to unlock pricing
          </span>
        {%- endif -%}
      </div>
    </section>
 
    {%- if chip_count > 0 -%}
      <section class="wrap bsubnav-wrap">
        <div class="bsubnav">
          {%- for block in section.blocks -%}
            {%- if block.type == 'chip' -%}
              <a
                class="bchip{% if block.settings.link == collection.url %} on{% endif %}"
                href="{{ block.settings.link | default: routes.all_products_collection_url }}"
                {{ block.shopify_attributes }}
              >{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </div>
 
{%- else -%}
 
  {%- liquid
    assign heading = section.settings.why_heading
    if heading == blank
      assign heading = 'Why pros choose ' | append: collection.title
    endif
 
    assign mf = collection.metafields.custom
 
    # Brand-specific points win when the collection has them; otherwise the
    # section's own point blocks render, so brands without metafields are unchanged.
    assign use_mf_points = false
    if mf.why_1_title.value != blank
      assign use_mf_points = true
    endif
 
    assign why_img = mf.why_image.value
    if why_img == blank
      assign why_img = section.settings.why_image
    endif
 
    assign faq_count = 0
    for i in (1..6)
      assign q_key = 'faq_' | append: i | append: '_q'
      assign a_key = 'faq_' | append: i | append: '_a'
      if mf[q_key].value != blank and mf[a_key].value != blank
        assign faq_count = faq_count | plus: 1
      endif
    endfor
  -%}
  <div class="cl">
    <section class="wrap bpage">
      <div class="bwhy {{ theme_class }}">
        <div class="bwhy-l">
          <span class="bkick">{{ section.settings.why_kick | escape }}</span>
          <h2 class="bwhy-h">{{ heading | escape }}</h2>
          <div class="bwhy-points">
            {%- if use_mf_points -%}
              {%- for i in (1..3) -%}
                {%- liquid
                  assign t_key = 'why_' | append: i | append: '_title'
                  assign s_key = 'why_' | append: i | append: '_text'
                  assign pt_t = mf[t_key].value
                  assign pt_s = mf[s_key].value
                -%}
                {%- if pt_t != blank -%}
                  <div class="bwhy-pt">
                    <div class="bwhy-dot"></div>
                    <div>
                      <div class="bwhy-t">{{ pt_t | escape }}</div>
                      {%- if pt_s != blank -%}
                        <div class="bwhy-s">{{ pt_s | escape }}</div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'point' -%}
                  <div class="bwhy-pt" {{ block.shopify_attributes }}>
                    <div class="bwhy-dot"></div>
                    <div>
                      <div class="bwhy-t">{{ block.settings.title | escape }}</div>
                      <div class="bwhy-s">{{ block.settings.text | escape }}</div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
        <div class="bwhy-r{% if why_img != blank %} lqip lqip--plate{% endif %}" style="{% render 'cartel-lqip', image: why_img %}">
          {%- if why_img != blank -%}
            {{ why_img | image_url: width: 900 | image_tag: class: 'bwhy-img', widths: '450,675,900', alt: heading }}
          {%- else -%}
            <div class="bwhy-ph bcard-ph">
              {%- if settings.logo -%}
                {{ settings.logo | image_url: width: 280 | image_tag: class: 'bcard-ph-logo', alt: shop.name }}
              {%- endif -%}
              <span class="bcard-ph-l">Photos coming soon</span>
            </div>
          {%- endif -%}
        </div>
      </div>
 
      {%- if faq_count > 0 -%}
        <div class="bfaq">
          <span class="bkick">FAQ</span>
          <h2 class="bfaq-h">{{ collection.title | escape }} questions, answered</h2>
          <div class="bfaq-list">
            {%- for i in (1..6) -%}
              {%- liquid
                assign q_key = 'faq_' | append: i | append: '_q'
                assign a_key = 'faq_' | append: i | append: '_a'
                assign fq = mf[q_key].value
                assign fa = mf[a_key].value
              -%}
              {%- if fq != blank and fa != blank -%}
                <details class="bfaq-item">
                  <summary class="bfaq-q">{{ fq | escape }}</summary>
                  <div class="bfaq-a">{{ fa | escape | newline_to_br }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
 
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {%- assign faq_printed = 0 -%}
              {%- for i in (1..6) -%}
                {%- liquid
                  assign q_key = 'faq_' | append: i | append: '_q'
                  assign a_key = 'faq_' | append: i | append: '_a'
                  assign fq = mf[q_key].value
                  assign fa = mf[a_key].value
                -%}
                {%- if fq != blank and fa != blank -%}
                  {%- if faq_printed > 0 -%},{%- endif -%}
                  {
                    "@type": "Question",
                    "name": {{ fq | json }},
                    "acceptedAnswer": { "@type": "Answer", "text": {{ fa | json }} }
                  }
                  {%- assign faq_printed = faq_printed | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          }
        </script>
      {%- endif -%}
 
      {%- if section.settings.cross_heading != blank -%}
        <div class="bcross">
          <div>
            <span class="bkick">{{ section.settings.cross_kick | escape }}</span>
            <div class="bcross-h">{{ section.settings.cross_heading | escape }}</div>
          </div>
          {%- if section.settings.cross_link != blank -%}
            <a class="btn btn-out" href="{{ section.settings.cross_link }}">{{ section.settings.cross_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </section>
  </div>
 
  {%- if faq_count > 0 -%}
    <style>
      .bfaq { margin-top: 48px; max-width: 820px; }
      .bfaq-h { margin: 8px 0 20px; }
      .bfaq-list { border-top: 1px solid rgba(0, 0, 0, 0.12); }
      .bfaq-item { border-bottom: 1px solid rgba(0, 0, 0, 0.12); }
      .bfaq-q {
        cursor: pointer;
        list-style: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 18px 0;
        font-weight: 600;
      }
      .bfaq-q::-webkit-details-marker { display: none; }
      .bfaq-q::after { content: '+'; font-size: 1.4em; line-height: 1; opacity: 0.6; }
      .bfaq-item[open] .bfaq-q::after { content: '\2212'; }
      .bfaq-a { padding: 0 0 20px; opacity: 0.85; line-height: 1.6; }
    </style>
  {%- endif -%}
{%- endif -%}
 
{% schema %}
{
  "name": "Cartel brand bands",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Band",
      "default": "hero",
      "options": [
        { "value": "hero", "label": "Hero (tabs, panel, category chips)" },
        { "value": "story", "label": "Story (why-pros band, cross-brand CTA)" }
      ]
    },
    { "type": "header", "content": "Hero band" },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Brand tabs label",
      "default": "Shop by brand"
    },
    { "type": "header", "content": "Story band" },
    {
      "type": "paragraph",
      "content": "Brands with 'Why point' and 'FAQ' metafields filled in use those automatically. The point blocks below are the fallback for brands without them."
    },
    {
      "type": "text",
      "id": "why_kick",
      "label": "Why-band eyebrow",
      "default": "The line"
    },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Why-band heading",
      "info": "Blank = “Why pros choose [collection title]”."
    },
    {
      "type": "image_picker",
      "id": "why_image",
      "label": "Why-band image",
      "info": "Fallback. A brand's 'Why image' metafield is used first."
    },
    {
      "type": "text",
      "id": "cross_kick",
      "label": "Cross-brand eyebrow",
      "default": "Keep exploring"
    },
    {
      "type": "text",
      "id": "cross_heading",
      "label": "Cross-brand heading",
      "info": "Blank hides the cross-brand band."
    },
    {
      "type": "text",
      "id": "cross_label",
      "label": "Cross-brand button label",
      "default": "View the line"
    },
    {
      "type": "url",
      "id": "cross_link",
      "label": "Cross-brand button link"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Hero: brand tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Brand collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Blank = collection title." }
      ]
    },
    {
      "type": "tab_soon",
      "name": "Hero: coming-soon tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "More soon" }
      ]
    },
    {
      "type": "chip",
      "name": "Hero: category chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "point",
      "name": "Story: point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Point title" },
        { "type": "text", "id": "text", "label": "Text", "default": "A line or two on what makes this brand worth the chair time." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cartel brand hero",
      "settings": { "mode": "hero" }
    },
    {
      "name": "Cartel brand story",
      "settings": { "mode": "story" },
      "blocks": [
        { "type": "point" },
        { "type": "point" },
        { "type": "point" }
      ]
    }
  ]
}
{% endschema %}
 