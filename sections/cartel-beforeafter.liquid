{% comment %}
  Cartel before / after slider — 1:1 with the approved prototype (.ba-cmp in Home.dc.html).
  Service chips switch the photo pair; drag (or arrow keys) reveals the before shot.
{% endcomment %}
<cl-ba class="cl">
  <section class="sec wrap" style="--cl-pt:{{ section.settings.pad_top }}px;--cl-pb:{{ section.settings.pad_bottom }}px">
    <div class="sec-head">
      <div class="sh-l">
        {%- if section.settings.kicker != blank -%}
          <span class="kick">{{ section.settings.kicker }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="stitle">{{ section.settings.title }}</h2>{%- endif -%}
      </div>
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="ba-chips">
        {%- for block in section.blocks -%}
          <button class="ba-chip{% if forloop.first %} on{% endif %}" type="button" data-ba-chip="{{ forloop.index0 }}">
            {{- block.settings.label -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="ba-cmp">
      {%- for block in section.blocks -%}
        <div class="ba-pair{% if forloop.first %} on{% endif %}" data-ba-pair="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="ba-layer">
            {%- if block.settings.after != blank -%}
              {{ block.settings.after | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', loading: 'lazy', alt: 'After' }}
            {%- endif -%}
            <span class="ba-tag ba-tagr">{{ section.settings.after_label }}</span>
          </div>
          <div class="ba-layer ba-before" style="clip-path:inset(0 50% 0 0)">
            {%- if block.settings.before != blank -%}
              {{ block.settings.before | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', loading: 'lazy', alt: 'Before' }}
            {%- endif -%}
            <span class="ba-tag ba-tagl">{{ section.settings.before_label }}</span>
          </div>
        </div>
      {%- endfor -%}
      <div class="ba-handle" style="left:50%">
        <div class="ba-grip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 7l-4 5 4 5M15 7l4 5-4 5"></path></svg>
        </div>
      </div>
      <input
        class="ba-range"
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="Drag to compare before and after"
      >
    </div>
    {%- if section.settings.hint != blank -%}<p class="ba-hint">{{ section.settings.hint }}</p>{%- endif -%}
  </section>
</cl-ba>

{% schema %}
{
  "name": "Cartel before / after",
  "tag": "section",
  "class": "cartel-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "See the difference" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Supplies that show in the results." },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    {
      "type": "text",
      "id": "hint",
      "label": "Hint",
      "default": "Drag to reveal the before & after, tap a service to see more results."
    },
    { "type": "range", "id": "pad_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 92 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 92 }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "label", "label": "Chip label", "default": "Korean lash lift" },
        { "type": "image_picker", "id": "before", "label": "Before photo" },
        { "type": "image_picker", "id": "after", "label": "After photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cartel before / after",
      "blocks": [{ "type": "pair" }, { "type": "pair" }, { "type": "pair" }, { "type": "pair" }]
    }
  ]
}
{% endschema %}
