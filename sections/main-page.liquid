{% comment %}
  Cartel plain page (lane 7E rewrite of Dawn's main-page) — used by pages with
  no template suffix. Breadcrumb + kick + title + the page's rich text, styled
  by cartel-page-default.css. Dawn's section-main-page.css is intentionally no
  longer loaded.
{% endcomment %}
<div class="cl">
  {%- if section.settings.show_breadcrumbs -%}
    <section class="wrap">{% render 'cartel-breadcrumbs' %}</section>
  {%- endif -%}
  <section class="sec wrap page-plain" style="--cl-pt:{{ section.settings.pad_top }}px;--cl-pb:{{ section.settings.pad_bottom }}px">
    {%- if section.settings.eyebrow != blank -%}<span class="kick">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="stitle">{{ page.title | escape }}</h1>
    <div class="page-rte rte">
      {{ page.content }}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Cartel page",
  "tag": "section",
  "class": "cartel-section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Cartel Lash" },
    { "type": "range", "id": "pad_top", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Padding top", "default": 10 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Padding bottom", "default": 78 }
  ]
}
{% endschema %}
