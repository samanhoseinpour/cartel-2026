{% comment %}
  Cartel blog index — 1:1 with the prototype (view: index in Blog.dc.html).
  Categories come from article TAGS (Technique / Education / Business / Supplies);
  chips link to {{ blog.url }}/tagged/<handle> so filtering is server-side.

  Tag counts: Liquid can only see the first 50 articles outside a tag filter, so
  with 70 posts the per-tag window counts undercount. Exact counts can be pinned
  via blog metafields custom.count_technique / count_education / count_business /
  count_supplies (integer) — set once at migration; they override the window count.
{% endcomment %}
{%- liquid
  assign cl_cats = 'Technique,Education,Business,Supplies' | split: ','
  assign c_technique = 0
  assign c_education = 0
  assign c_business = 0
  assign c_supplies = 0
  # The nested `blog.articles x a.tags` scan that used to sit here is gone. It
  # ran OUTSIDE the paginate below, so it triggered a second, separate article
  # fetch (Shopify caps it at 50) and walked up to ~250 iterations doing a
  # downcase + 4-way case each — to produce four integers for the filter chips.
  # It was also wrong by construction: the header comment above already notes it
  # undercounts past 50 articles, and there are 70 posts. The metafield overrides
  # below are the accurate source; where one is unset the chip simply renders
  # without a count, which the markup already handles.
  # .value is required: without it these are metafield OBJECTS, and `object > 0`
  # at the chip-count test below is always false, so the override silently did nothing.
  if blog.metafields.custom.count_technique.value != blank
    assign c_technique = blog.metafields.custom.count_technique.value
  endif
  if blog.metafields.custom.count_education.value != blank
    assign c_education = blog.metafields.custom.count_education.value
  endif
  if blog.metafields.custom.count_business.value != blank
    assign c_business = blog.metafields.custom.count_business.value
  endif
  if blog.metafields.custom.count_supplies.value != blank
    assign c_supplies = blog.metafields.custom.count_supplies.value
  endif
  assign curtags_d = current_tags | join: ',' | downcase
-%}
<div class="cl">
  <section class="wrap">
    {% render 'cartel-breadcrumbs' %}
  </section>

  {%- paginate blog.articles by section.settings.per_page -%}
    <section class="wrap bl-wrap">
      <header class="bl-head">
        <span class="kick">{{ section.settings.heading_kick }}</span>
        <h1 class="bl-h1">{{ section.settings.heading }}</h1>
        {%- if section.settings.lead != blank -%}
          <p class="bl-lead">{{ section.settings.lead }}</p>
        {%- endif -%}
      </header>

      <div class="bl-filters" id="bl-top">
        <a
          class="bl-fchip{% if current_tags == blank %} on{% endif %}"
          href="{{ blog.url }}"
        >
          All
          {%- if blog.articles_count > 0 -%}
            <span class="bl-fchip-n">{{ blog.articles_count }}</span>
          {%- endif -%}
        </a>
        {%- for c in cl_cats -%}
          {%- liquid
            assign cd = c | downcase
            assign chip_count = 0
            case cd
              when 'technique'
                assign chip_count = c_technique
              when 'education'
                assign chip_count = c_education
              when 'business'
                assign chip_count = c_business
              when 'supplies'
                assign chip_count = c_supplies
            endcase
            assign chip_on = false
            if curtags_d contains cd
              assign chip_on = true
              if chip_count == 0
                assign chip_count = paginate.items
              endif
            endif
          -%}
          <a
            class="bl-fchip{% if chip_on %} on{% endif %}"
            href="{{ blog.url }}/tagged/{{ c | handle }}"
          >
            {{ c }}
            {%- if chip_count > 0 -%}
              <span class="bl-fchip-n">{{ chip_count }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>

      {%- liquid
        assign grid_offset = 0
        assign show_feature = false
        if current_tags == blank and paginate.current_page == 1 and blog.articles.size > 0
          assign show_feature = true
          assign grid_offset = 1
        endif
      -%}

      {%- if show_feature -%}
        {%- liquid
          assign feat = blog.articles.first
          assign feat_cat = ''
          for t in feat.tags
            assign td = t | downcase
            for c in cl_cats
              assign cd = c | downcase
              if td == cd
                assign feat_cat = c
                break
              endif
            endfor
            if feat_cat != blank
              break
            endif
          endfor
          assign feat_initials = ''
          assign feat_words = feat.author | strip | split: ' '
          for w in feat_words limit: 2
            assign letter = w | slice: 0, 1 | upcase
            assign feat_initials = feat_initials | append: letter
          endfor
          if feat_initials == blank
            assign feat_initials = 'CL'
          endif
          # Same expression as snippets/article-card.liquid — the featured post
          # sits directly above the card grid, so a different formula here would
          # show two read times for comparable articles side by side.
          assign feat_mins = feat.metafields.custom.read_minutes.value
          unless feat_mins > 0
            assign feat_txt = feat.content | strip_html
            assign feat_mins = feat_txt.size | divided_by: 1100 | at_least: 1
          endunless
        -%}
        <article class="bl-feat">
          <div class="bl-feat-img">
            {%- if feat_cat != blank -%}<span class="bl-card-cat">{{ feat_cat }}</span>{%- endif -%}
            <a href="{{ feat.url }}" aria-label="{{ feat.title | escape }}" tabindex="-1">
              {%- if feat.image -%}
                {{
                  feat.image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'bl-card-photo',
                    widths: '700,1000,1400',
                    sizes: '(min-width: 760px) 58vw, 100vw',
                    loading: 'eager',
                    alt: feat.title
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'bl-card-photo' }}
              {%- endif -%}
            </a>
          </div>
          <div class="bl-feat-b">
            <span class="bl-feat-k">The latest</span>
            <h2 class="bl-feat-h"><a href="{{ feat.url }}">{{ feat.title | escape }}</a></h2>
            <p class="bl-feat-x">{{ feat.excerpt_or_content | strip_html | truncate: 180 }}</p>
            <div class="bl-card-meta">
              <div class="bl-avatar sm" aria-hidden="true">{{ feat_initials }}</div>
              <div class="bl-meta-txt">
                <span class="bl-meta-by">{{ feat.author }}</span>
                <span class="bl-meta-sub">
                  {{- feat.published_at | date: '%b %-d, %Y' }} · {{ feat_mins }} min read
                </span>
              </div>
            </div>
            <a class="btn btn-fill" href="{{ feat.url }}">
              Read article
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
        </article>
      {%- endif -%}

      {%- if blog.articles.size > 0 -%}
        <div class="bl-grid">
          {%- for article in blog.articles offset: grid_offset -%}
            {% render 'article-card', article: article %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="bl-empty">No articles in this category yet, check back soon.</div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="bl-pag" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a class="bl-pag-arrow" href="{{ paginate.previous.url }}" aria-label="Previous page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
            </a>
          {%- else -%}
            <span class="bl-pag-arrow" aria-disabled="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
            </span>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="bl-pag-num" href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title contains 'hellip' or part.title == '…' -%}
              <span class="bl-pag-gap">…</span>
            {%- else -%}
              <span class="bl-pag-num on" aria-current="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a class="bl-pag-arrow" href="{{ paginate.next.url }}" aria-label="Next page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
            </a>
          {%- else -%}
            <span class="bl-pag-arrow" aria-disabled="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
            </span>
          {%- endif -%}
        </nav>
      {%- endif -%}

      {%- liquid
        assign promo_col = section.settings.promo_collection
        assign promo_url = routes.all_products_collection_url
        if promo_col != blank
          assign promo_url = promo_col.url
        endif
      -%}
      <div class="bl-promo">
        <div class="bl-promo-img">
          {%- if section.settings.promo_image -%}
            {{
              section.settings.promo_image
              | image_url: width: 1200
              | image_tag: class: 'bl-card-photo', widths: '600,900,1200', sizes: '(min-width: 760px) 52vw, 100vw', loading: 'lazy', alt: section.settings.promo_heading
            }}
          {%- elsif promo_col.featured_image -%}
            {{
              promo_col.featured_image
              | image_url: width: 1200
              | image_tag: class: 'bl-card-photo', widths: '600,900,1200', sizes: '(min-width: 760px) 52vw, 100vw', loading: 'lazy', alt: section.settings.promo_heading
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'bl-card-photo' }}
          {%- endif -%}
          {%- if section.settings.promo_badge != blank -%}
            <span class="bl-promo-badge">{{ section.settings.promo_badge }}</span>
          {%- endif -%}
        </div>
        <div class="bl-promo-b">
          <span class="bl-promo-k">{{ section.settings.promo_kick }}</span>
          <h2 class="bl-promo-h">{{ section.settings.promo_heading }}</h2>
          <p class="bl-promo-x">{{ section.settings.promo_text }}</p>
          <a class="btn btn-fill" href="{{ promo_url }}">
            {{ section.settings.promo_cta }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>

      <div class="bl-news">
        <div class="bl-news-glow"></div>
        <div class="bl-news-l">
          <span class="bl-news-k">{{ section.settings.news_kick }}</span>
          <h2 class="bl-news-h">{{ section.settings.news_heading }}</h2>
          <p class="bl-news-p">{{ section.settings.news_text }}</p>
        </div>
        <div class="bl-news-r">
          {%- comment -%}
            posted_successfully? is scoped to form_type, not to this form, so
            the popup and the footer newsletter both flipped this band to its
            success state. Render both halves and let cartel-conversion.js keep
            the one whose id matches the redirect fragment.
          {%- endcomment -%}
          {%- assign news_form_id = 'CartelBlogNews-' | append: section.id -%}
          {%- form 'customer', id: news_form_id, class: 'bl-news-formwrap' -%}
            {%- if form.posted_successfully? -%}
              <div class="bl-news-done" data-cl-form-ok="{{ news_form_id }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                You’re on the list, see you in your inbox.
              </div>
            {%- endif -%}
            {%- assign news_hide = '' -%}
            {%- if form.posted_successfully? -%}
              {%- assign news_hide = ' hidden' -%}
            {%- endif -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="bl-news-form{{ news_hide }}" data-cl-form-fields="{{ news_form_id }}">
              <input
                class="bl-news-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                aria-label="Email address"
                placeholder="Your email address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >
              <button class="btn btn-bronze" type="submit">Subscribe</button>
            </div>
            {%- if form.errors -%}
              <span class="bl-news-err" role="alert" data-cl-form-msg="{{ news_form_id }}">
                Please enter a valid email address.
              </span>
            {%- endif -%}
            <span class="bl-news-note{{ news_hide }}" data-cl-form-fields="{{ news_form_id }}">
              {{- section.settings.news_note -}}
            </span>
          {%- endform -%}
        </div>
      </div>
    </section>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Cartel blog index",
  "tag": "section",
  "class": "cartel-section",
  "settings": [
    {
      "type": "text",
      "id": "heading_kick",
      "label": "Kicker",
      "default": "The Cartel Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Field notes for lash & brow pros"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Technique, education and the business of beauty, written by our educators for the artists we supply."
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "label": "Articles per page",
      "default": 12
    },
    {
      "type": "header",
      "content": "Shop promo band"
    },
    {
      "type": "text",
      "id": "promo_kick",
      "label": "Kicker",
      "default": "From the shop"
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Heading",
      "default": "Eyelash aftercare your clients will actually use"
    },
    {
      "type": "textarea",
      "id": "promo_text",
      "label": "Text",
      "default": "Every client needs to care for their extensions, it’s a must. Stock the cleansers, brushes and serums they reach for between fills."
    },
    {
      "type": "text",
      "id": "promo_badge",
      "label": "Image badge",
      "default": "Popular right now"
    },
    {
      "type": "text",
      "id": "promo_cta",
      "label": "Button label",
      "default": "Shop aftercare"
    },
    {
      "type": "collection",
      "id": "promo_collection",
      "label": "Collection"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Image (falls back to the collection image)"
    },
    {
      "type": "header",
      "content": "Newsletter band"
    },
    {
      "type": "text",
      "id": "news_kick",
      "label": "Kicker",
      "default": "The Cartel Journal"
    },
    {
      "type": "text",
      "id": "news_heading",
      "label": "Heading",
      "default": "New guides, in your inbox"
    },
    {
      "type": "textarea",
      "id": "news_text",
      "label": "Text",
      "default": "Join the list for fresh technique breakdowns, shade references and studio business tips, no fluff, just the good stuff."
    },
    {
      "type": "text",
      "id": "news_note",
      "label": "Note",
      "default": "One email a month. Unsubscribe anytime."
    }
  ]
}
{% endschema %}
