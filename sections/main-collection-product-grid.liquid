{% comment %}
  Cartel PLP toolbar + facets + grid — batch 7A, 1:1 with Collection.dc.html.
  Dawn facets.js contracts kept: #ProductGridContainer wraps a .collection
  element, #product-grid carries data-id, #ProductCount holds the count text,
  facet markup comes from the shared facets snippet. Cards are the frozen
  cartel-card component; pagination is Dawn's snippet restyled in cartel-plp.css.
{% endcomment %}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign any_active = 0
  for f in collection.filters
    if f.type == 'price_range'
      if f.min_value.value != null or f.max_value.value != null
        assign any_active = any_active | plus: 1
      endif
    else
      assign any_active = any_active | plus: f.active_values.size
    endif
  endfor

  assign show_rail = false
  if section.settings.enable_filtering and collection.filters != empty
    assign show_rail = true
  endif
-%}

<div class="cl">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <section class="wrap">
      <div
        class="plptop facets-container"
        data-collection-id="{{ collection.id }}"
        data-collection-handle="{{ collection.handle }}"
        data-template="{{ template.name }}"
      >
        <span
          id="ProductCount"
          class="plpcount"
          data-product-count="{{ collection.products_count }}"
          data-total-count="{{ collection.all_products_count }}"
          role="status"
        >
          Showing <span class="cnum">{{ collection.products.size }}</span> of {{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}
        </span>
        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <div class="plptop-r">
            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              part: 'toolbar'
            %}
          </div>
        {%- endif -%}
      </div>
      {%- if show_rail -%}
        {% render 'facets', results: collection, enable_filtering: true, part: 'active' %}
      {%- endif -%}
    </section>

    <section class="wrap">
      <div class="plpbody{% unless show_rail %} plpbody--full{% endunless %}">
        {%- if show_rail -%}
          {% render 'facets',
            results: collection,
            enable_filtering: true,
            enable_sorting: section.settings.enable_sorting,
            part: 'rail'
          %}
        {%- endif -%}
        <div class="plpmain">
          <div id="ProductGridContainer">
            {%- if collection.products.size == 0 -%}
              <div class="collection" id="product-grid" data-id="{{ section.id }}">
                <div class="emptywrap">
                  <div class="empty-ic">
                    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3M9 11h4"></path></svg>
                  </div>
                  {%- if any_active > 0 -%}
                    <div class="empty-t">No products match those filters</div>
                    <p class="empty-p">Try removing a filter or two to see more of the collection.</p>
                    <facet-remove class="js-facet-remove"><a href="{{ collection.url }}" class="btn btn-fill">Clear all filters</a></facet-remove>
                  {%- else -%}
                    <div class="empty-t">Nothing here yet</div>
                    <p class="empty-p">This collection is being restocked, check back soon.</p>
                    <a href="{{ routes.all_products_collection_url }}" class="btn btn-fill">Shop all supplies</a>
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              <div class="collection">
                <div id="product-grid" class="pgrid" data-id="{{ section.id }}">
                  {%- for product in collection.products -%}
                    {% render 'cartel-card', card_product: product %}
                  {%- endfor -%}
                </div>
                {% render 'pagination', paginate: paginate %}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </section>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Product grid",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "Configure filters in the Search & Discovery app."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}
