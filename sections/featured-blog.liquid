{% comment %}
  Cartel journal teaser — a .bl-grid band of recent articles for any page.
  The blog index's own featured card lives in main-blog.liquid; this section is
  for surfacing the Journal elsewhere (home, content pages).
  Loads cartel-blog.css itself because that file is otherwise only loaded on
  blog / article templates by theme.liquid.
{% endcomment %}
{{ 'cartel-blog.css' | asset_url | stylesheet_tag }}

<div class="cl">
  <section
    class="sec wrap"
    style="--cl-pt:{{ section.settings.pad_top }}px;--cl-pb:{{ section.settings.pad_bottom }}px"
  >
    <div class="bl-tsr-head">
      <div class="bl-tsr-t">
        {%- if section.settings.kick != blank -%}
          <span class="kick">{{ section.settings.kick }}</span>
        {%- endif -%}
        <h2 class="stitle">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.cta_label != blank and section.settings.blog != blank -%}
        <a class="btn btn-out bl-tsr-cta" href="{{ section.settings.blog.url }}">
          {{ section.settings.cta_label }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
        </a>
      {%- endif -%}
    </div>
    <div class="bl-grid">
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
          {% render 'article-card', article: article %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="bl-card">
            <div class="bl-card-img">
              {{ 'image' | placeholder_svg_tag: 'bl-card-photo' }}
            </div>
            <h3 class="bl-card-h">Article title</h3>
            <p class="bl-card-x">Pick a blog in the section settings to show its latest guides here.</p>
            <div class="bl-card-meta">
              <div class="bl-avatar sm" aria-hidden="true">CL</div>
              <div class="bl-meta-txt">
                <span class="bl-meta-by">Author</span>
                <span class="bl-meta-sub">Date · read time</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Cartel journal teaser",
  "tag": "section",
  "class": "cartel-section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "kick",
      "label": "Kicker",
      "default": "The Cartel Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Journal"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Read the Journal"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 3,
      "max": 12,
      "step": 3,
      "label": "Articles",
      "default": 3
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 92
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 92
    }
  ],
  "presets": [
    {
      "name": "Cartel journal teaser"
    }
  ]
}
{% endschema %}
