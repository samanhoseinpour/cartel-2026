{% comment %}
  Cartel cart page — 1:1 with the approved prototype (Cart.dc.html), lane 7C.
  The whole page (head, free-ship bar, lines, summary, empty state, saved,
  recommendations) renders here; main-cart-footer is a functional stub kept
  only for cart.js section rendering. Dawn contracts preserved: <cart-items>,
  form#cart, #main-cart-items[data-id] > .js-contents, #CartItem-{n},
  <quantity-input> with #Quantity-{n}, <cart-remove-button data-index>,
  #Line-item-error-{n}, the two live-region <p>s and #cart-errors.
  Thuya gate: line_item.product.vendor == 'Thuya' and customer == nil.
{% endcomment %}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  # Accumulate the priced (non-gated) side DIRECTLY. Deriving it by subtracting
  # the gated lines from the cart totals mixed two different bases:
  # final_line_price is before cart-level discounts, cart.total_price is after —
  # so any cart-level discount came off twice and an all-gated cart could render
  # a NEGATIVE estimated total.
  assign gate_count = 0
  assign priced_units = 0
  assign priced_subtotal = 0
  for item in cart.items
    if item.product.vendor == 'Thuya' and customer == nil
      assign gate_count = gate_count | plus: 1
    else
      assign priced_units = priced_units | plus: item.quantity
      assign priced_subtotal = priced_subtotal | plus: item.final_line_price
    endif
  endfor
  assign display_subtotal = priced_subtotal
  # Nothing gated → the cart's own totals are exact, and subtotal − discounts
  # reconciles. With gated lines present a cart-level discount cannot be split
  # per line in Liquid, so the honest figure is the priced subtotal; the "+"
  # suffix and the "Log in to see your total" CTA already say it is partial,
  # and the discount rows below switch to a non-numeric note to match.
  if gate_count > 0
    assign display_total = priced_subtotal
  else
    assign display_total = cart.total_price
  endif
  # Free-shipping progress has to track the total the shopper can actually see.
  # Reading cart.total_price included the gated prices, which contradicted the
  # "Subtotal · 0 items $0.00" row right above it and let a logged-out visitor
  # derive the gated subtotal from "$X away from free shipping".
  assign ship_threshold = 15000
  assign ship_remaining = ship_threshold | minus: display_total
  assign ship_free = false
  if display_total >= ship_threshold
    assign ship_free = true
  endif
  assign ship_pct = display_total | times: 100 | divided_by: ship_threshold
  if ship_pct > 100
    assign ship_pct = 100
  endif
-%}

<cart-items
  class="cl{% if cart == empty %} is-empty{% endif %}"
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="wrap cartpage">
    {% render 'cartel-breadcrumbs', extra_label: 'Your bag' %}

    {%- comment -%}
      NOT class="cart__contents". Dawn's component-cart.css hides `.is-empty
      .cart__contents`, and cart.js puts `is-empty` on <cart-items> above. Dawn
      gets away with it because its empty state lives outside the form; this page
      renders the empty state INSIDE it, so the rule would blank the whole cart
      page. Harmless today only because theme.liquid loads component-cart.css
      solely when cart_type is "drawer" — i.e. it would break the moment the
      client flips the cart to Drawer.
    {%- endcomment -%}
    <form action="{{ routes.cart_url }}" class="cl-cart-contents" method="post" id="cart">
      <div id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          <div class="cart-head">
            <div class="cart-head-l">
              <span class="kick">Your bag</span>
              <h1 class="stitle cart-title">Shopping bag</h1>
              <span class="cart-count-note">
                {%- if cart == empty -%}
                  0 items in your bag
                {%- else -%}
                  {{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %} in your bag
                  {%- if gate_count > 0 %} · {{ gate_count }} to price at login{% endif -%}
                {%- endif -%}
              </span>
            </div>
            <a class="cart-continue" href="{{ routes.all_products_collection_url }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 6l-6 6 6 6"></path></svg>
              Continue shopping
            </a>
          </div>

          {%- if cart == empty -%}
            <div class="cart-empty">
              <div class="cart-empty-ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6.5 8h11l-1 11.5a1.5 1.5 0 0 1-1.5 1.4H9a1.5 1.5 0 0 1-1.5-1.4L6.5 8z"></path><path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path></svg>
              </div>
              <div class="cart-empty-t">Your bag is empty</div>
              <p class="cart-empty-p">Looks like you haven't added anything yet. Browse the shop to stock up on your studio essentials.</p>
              <a class="btn btn-fill" href="{{ routes.all_products_collection_url }}">Start shopping</a>
              <div class="cart-empty-chips">
                <a class="echip" href="{{ collections['lash-extension'].url | default: routes.all_products_collection_url }}">Lash Extension</a>
                <a class="echip" href="{{ collections['lash-lift'].url | default: routes.all_products_collection_url }}">Lash Lift</a>
                <a class="echip" href="{{ collections['brows'].url | default: routes.all_products_collection_url }}">Brows</a>
                <a class="echip" href="{{ collections['dyes-tints'].url | default: routes.all_products_collection_url }}">Dyes &amp; Tints</a>
              </div>
            </div>
          {%- else -%}
            <div class="cart-grid">
              <div class="cart-main">
                <div class="ship-card">
                  <div class="ship-row">
                    <div class="ship-ic">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h11v8H3z"></path><path d="M14 10h4l3 3v2h-7z"></path><circle cx="7.5" cy="17" r="1.8"></circle><circle cx="17.5" cy="17" r="1.8"></circle></svg>
                    </div>
                    <div class="ship-txt">
                      {%- if ship_free -%}
                        You've earned free shipping
                      {%- else -%}
                        You're <b>{{ ship_remaining | money }}</b> away from free shipping
                      {%- endif -%}
                    </div>
                  </div>
                  <div class="ship-bar"><div class="ship-bar-f" style="width: {{ ship_pct }}%"></div></div>
                </div>

                <div class="lines">
                  {%- for item in cart.items -%}
                    {%- liquid
                      assign line_gated = false
                      if item.product.vendor == 'Thuya' and customer == nil
                        assign line_gated = true
                      endif
                    -%}
                    <div class="line cart-item" id="CartItem-{{ item.index | plus: 1 }}">
                      <div class="line-prod">
                        <div class="line-img">
                          <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                            {%- if item.image -%}
                              <img
                                class="line-photo"
                                src="{{ item.image | image_url: width: 300 }}"
                                alt="{{ item.image.alt | escape }}"
                                loading="lazy"
                                width="90"
                                height="104"
                              >
                            {%- else -%}
                              {{ 'product-1' | placeholder_svg_tag: 'line-photo' }}
                            {%- endif -%}
                          </a>
                        </div>
                        <div class="line-info">
                          {%- if item.product.vendor != blank -%}
                            <span class="line-brand">{{ item.product.vendor }}</span>
                          {%- endif -%}
                          <a class="line-name cart-item__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                          {%- unless item.product.has_only_default_variant -%}
                            <span class="line-var">{{ item.variant.title }}</span>
                          {%- endunless -%}
                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <span class="line-var">{{ property.first }}: {{ property.last }}</span>
                            {%- endif -%}
                          {%- endfor -%}
                          {%- if item.selling_plan_allocation != null -%}
                            <span class="line-var">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                          {%- endif -%}
                          {%- comment -%}
                            Shopify Bundles child lines report can_remove/can_update_quantity
                            false; without these guards they were independently editable, which
                            corrupts the bundle. Save-for-later removes the line, so it is
                            gated on can_remove too.

                            allow_false is required and is a deliberate divergence from the
                            Dawn baseline (main-cart-items:308), which has the same defect:
                            Liquid's `default` substitutes on nil, "" AND false, so a bundle
                            child reporting can_remove == false read back as true and every
                            `== false` guard below was dead code.
                          {%- endcomment -%}
                          {%- assign can_remove = item.instructions.can_remove
                            | default: true, allow_false: true
                          -%}
                          <div class="line-tools">
                            <button
                              type="button"
                              class="line-tool line-save{% if can_remove == false %} hidden{% endif %}"
                              data-line-save
                              data-variant-id="{{ item.variant.id }}"
                              data-product-title="{{ item.product.title | escape }}"
                              data-brand="{{ item.product.vendor | escape }}"
                              data-variant-title="{% unless item.product.has_only_default_variant %}{{ item.variant.title | escape }}{% endunless %}"
                              {%- comment -%}
                                Catalogue price, not final_price: a saved item leaves the cart,
                                so cart-level discounts no longer apply to it.
                              {%- endcomment -%}
                              data-price="{% unless line_gated %}{{ item.variant.price }}{% endunless %}"
                              data-image="{% if item.image %}{{ item.image | image_url: width: 600 }}{% endif %}"
                              data-url="{{ item.url }}"
                            >
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M7 4h10v16l-5-3.5L7 20z"></path></svg>
                              Save for later
                            </button>
                            <cart-remove-button
                              data-index="{{ item.index | plus: 1 }}"
                              {% if can_remove == false %}class="hidden"{% endif %}
                            >
                              <button type="button" class="line-tool" aria-label="Remove {{ item.product.title | escape }}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M9.5 7V5h5v2M6.5 7l.8 13h9.4l.8-13"></path></svg>
                                Remove
                              </button>
                            </cart-remove-button>
                          </div>
                        </div>
                      </div>
                      <div class="line-qtyc">
                        {%- assign can_update_quantity = item.instructions.can_update_quantity
                          | default: true, allow_false: true
                        -%}
                        <quantity-input class="qty qty-lg">
                          <button class="qbtn quantity__button" name="minus" type="button" {% if can_update_quantity == false %}disabled{% endif %}>
                            <span class="visually-hidden">Decrease quantity for {{ item.product.title | escape }}</span>
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14"></path></svg>
                          </button>
                          <input
                            class="qn"
                            type="number"
                            name="updates[]"
                            value="{{ item.quantity }}"
                            data-quantity-variant-id="{{ item.variant.id }}"
                            data-quantity-line-key="{{ item.key }}"
                            {% # theme-check-disable %}
                            data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                            min="0"
                            data-min="{{ item.variant.quantity_rule.min }}"
                            {% if item.variant.quantity_rule.max != null %}
                              max="{{ item.variant.quantity_rule.max }}"
                            {% endif %}
                            step="{{ item.variant.quantity_rule.increment }}"
                            {% # theme-check-enable %}
                            aria-label="Quantity for {{ item.product.title | escape }}"
                            id="Quantity-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                            {% if can_update_quantity == false %}disabled{% endif %}
                          >
                          <button class="qbtn quantity__button" name="plus" type="button" {% if can_update_quantity == false %}disabled{% endif %}>
                            <span class="visually-hidden">Increase quantity for {{ item.product.title | escape }}</span>
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                          </button>
                        </quantity-input>
                      </div>
                      <div class="line-pricec">
                        {%- render 'loading-spinner' -%}
                        {%- if line_gated -%}
                          {% render 'cartel-gate-cta', gate_style: 'card' %}
                        {%- comment -%}
                          variant.price, not final_price — final_price is post-discount, so a
                          gift-with-purchase or 100%-off line was reading as "Price on request".
                        {%- endcomment -%}
                        {%- elsif item.variant.price == 0 -%}
                          <span class="line-price">Price on request</span>
                        {%- else -%}
                          <span class="line-price">{{ item.final_line_price | money }}</span>
                          <span class="line-unit">{{ item.final_price | money }} each</span>
                        {%- endif -%}
                      </div>
                      {%- comment -%}
                        Same can_remove guard as the .line-tools button above —
                        cart.js binds updateQuantity(index, 0) to EVERY
                        cart-remove-button, so an unguarded second control still
                        deleted a non-removable bundle child.
                      {%- endcomment -%}
                      <cart-remove-button
                        data-index="{{ item.index | plus: 1 }}"
                        {% if can_remove == false %}class="hidden"{% endif %}
                      >
                        <button type="button" class="line-rm" aria-label="Remove {{ item.product.title | escape }}">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                        </button>
                      </cart-remove-button>
                      <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                        <small class="cart-item__error-text"></small>
                        <span class="svg-wrapper">
                          {{- 'icon-error.svg' | inline_asset_content -}}
                        </span>
                      </div>
                    </div>
                  {%- endfor -%}
                </div>

                <cart-note class="cart__note">
                  <button type="button" class="note-toggle" data-note-toggle aria-expanded="{% if cart.note != blank %}true{% else %}false{% endif %}" aria-controls="Cart-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 5h16M4 10h16M4 15h10"></path></svg>
                    <span data-note-label>{% if cart.note != blank %}Hide order note{% else %}Add a note to your order{% endif %}</span>
                  </button>
                  <textarea
                    class="note-box"
                    name="note"
                    id="Cart-note"
                    placeholder="Add a note for your order, pick-up preference, studio name, special instructions&hellip;"
                    {% if cart.note == blank %}hidden{% endif %}
                  >{{ cart.note }}</textarea>
                </cart-note>
              </div>

              <aside class="summary">
                <div class="sum-card">
                  <h2 class="sum-h">Order summary</h2>
                  <div class="sum-row">
                    <span>Subtotal · {{ priced_units }} item{% if priced_units != 1 %}s{% endif %}</span>
                    <span class="sum-row-v">{{ display_subtotal | money }}</span>
                  </div>
                  {%- comment -%}
                    Only show the amount when it actually reconciles. With gated
                    lines in the bag the estimated total is the priced subtotal,
                    so printing "−$10.00" between it and the subtotal would be
                    arithmetic the shopper can see is wrong.
                  {%- endcomment -%}
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <div class="sum-row">
                      <span>Discount · {{ discount.title | escape }}</span>
                      {%- if gate_count > 0 -%}
                        <span class="muted-val">Applied at checkout</span>
                      {%- else -%}
                        <span class="sum-row-v sum-free">&minus;{{ discount.total_allocated_amount | money }}</span>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                  <div class="sum-row">
                    <span>Shipping</span>
                    {%- if ship_free -%}
                      <span class="sum-row-v sum-free">Free</span>
                    {%- else -%}
                      <span class="muted-val">Calculated at checkout</span>
                    {%- endif -%}
                  </div>

                  <div data-promo-zone>
                    <div class="promo-applied" data-promo-applied hidden>
                      <span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12.5l4 4L19 7"></path></svg>
                        <b data-promo-code></b>&nbsp;applied
                      </span>
                      <button type="button" class="promo-x" data-promo-clear aria-label="Remove discount code">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                      </button>
                    </div>
                    <div class="promo" data-promo-form>
                      <input class="promo-input" data-promo-input placeholder="Discount code" aria-label="Discount code" autocomplete="off">
                      <button type="button" class="btn btn-out btn-sm" data-promo-apply>Apply</button>
                    </div>
                    <div class="promo-msg promo-ok" data-promo-msg hidden>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12.5l4 4L19 7"></path></svg>
                      Applied at checkout
                    </div>
                    <div class="promo-msg promo-err" data-promo-err hidden>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16h.01"></path></svg>
                      <span data-promo-err-text>Enter a discount code</span>
                    </div>
                  </div>

                  {%- if gate_count > 0 -%}
                    <div class="sum-locknote">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
                      <div class="sum-locknote-t">
                        <b>{{ gate_count }} Thuya item{% if gate_count != 1 %}s{% endif %} priced after login.</b>
                        Log in or create a free account to reveal pro pricing and check out.
                      </div>
                    </div>
                  {%- endif -%}

                  <div class="sum-div"></div>
                  <div class="sum-total">
                    <span class="sum-total-l">Estimated total</span>
                    <span class="sum-total-v">{{ display_total | money }}{% if gate_count > 0 %}+{% endif %}</span>
                  </div>
                  <div class="sum-tax">
                    {%- if ship_free -%}Taxes calculated at checkout{%- else -%}Taxes &amp; shipping calculated at checkout{%- endif -%}
                  </div>

                  {%- if gate_count > 0 -%}
                    <a class="btn btn-fill w100 checkout-btn" href="{{ routes.account_login_url }}">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
                      Log in to see your total
                    </a>
                  {%- else -%}
                    <button type="submit" id="checkout" class="btn btn-fill w100 checkout-btn" name="checkout">
                      Checkout · {{ display_total | money }}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                    </button>
                  {%- endif -%}

                  <a class="sum-cont" href="{{ routes.all_products_collection_url }}">or continue shopping</a>
                  <div class="sum-secure">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
                    Secure checkout · SSL encrypted
                  </div>
                  <div class="sum-pay">
                    <span class="paychip">VISA</span>
                    <span class="paychip">MC</span>
                    <span class="paychip">AMEX</span>
                    <span class="paychip">APPLE PAY</span>
                    <span class="paychip">G PAY</span>
                    <span class="paychip">SHOP</span>
                  </div>
                  <div id="cart-errors" class="cart-errs" role="alert"></div>
                </div>

                <div class="perk">
                  <div class="perk-row">
                    <div class="perk-ic">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 21s-6-5.3-6-10A6 6 0 0 1 18 11c0 4.7-6 10-6 10z"></path><circle cx="12" cy="11" r="2.2"></circle></svg>
                    </div>
                    <div>
                      <div class="perk-t">Free local pick-up</div>
                      <div class="perk-s">Collect in West Vancouver or Burnaby, choose your spot at checkout.</div>
                    </div>
                  </div>
                  <div class="perk-row">
                    <div class="perk-ic">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="9" width="16" height="11" rx="2"></rect><path d="M4 12h16M9 9V6.5A2.5 2.5 0 0 1 12 4a2.5 2.5 0 0 1 3 2.5V9"></path></svg>
                    </div>
                    <div>
                      <div class="perk-t">Add a gift note</div>
                      <div class="perk-s">Sending to a fellow artist? Add a personal note at checkout.</div>
                    </div>
                  </div>
                </div>
              </aside>
            </div>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        Loading&hellip;
      </p>
    </form>

    <section class="saved" data-saved-zone hidden>
      <div class="saved-head">
        <span class="saved-h">Saved for later</span>
        <span class="saved-count" data-saved-count></span>
      </div>
      <div class="saved-grid" data-saved-grid></div>
    </section>

    {%- assign rec_coll = collections[section.settings.rec_collection] -%}
    {%- if rec_coll.products.size > 0 or request.design_mode -%}
      <section class="rec">
        <div class="rec-head">
          <h2 class="rec-h">{{ section.settings.rec_title | default: 'Complete your kit' }}</h2>
          <span class="rec-sub">{{ section.settings.rec_sub | default: "Pairs well with what's in your bag" }}</span>
        </div>
        <div class="rec-grid">
          {%- liquid
            # The outer loop had no `limit:`, and each iteration ran a FULL nested
            # scan of cart.items to decide whether to skip the product. If the
            # shopper's cart happened to contain the first products of the
            # collection, it kept going to Shopify's 50-item cap — a 15-line cart
            # against a 50-product collection is 750 comparisons before four cards
            # render. Hoisting the cart's product ids into one delimited string
            # turns the per-product test into a single `contains`, and the limit
            # bounds the fetch. Commas on both ends make it an exact-id match, so
            # product 123 can't match inside 1234.
            assign cart_pids = cart.items | map: 'product' | map: 'id' | join: ',' | prepend: ',' | append: ','
            assign rec_shown = 0
            for rec_product in rec_coll.products limit: 12
              if rec_shown >= 4
                break
              endif
              assign rec_id = rec_product.id | prepend: ',' | append: ','
              unless cart_pids contains rec_id
                assign rec_shown = rec_shown | plus: 1
                render 'cartel-card', card_product: rec_product
              endunless
            endfor
            if rec_shown == 0 and request.design_mode
              for i in (1..4)
                render 'cartel-card'
              endfor
            endif
          -%}
        </div>
      </section>
    {%- endif -%}
  </div>
</cart-items>

{% schema %}
{
