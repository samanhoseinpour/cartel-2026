{% comment %}
  Cartel page hero — shared header band for the content pages (lane 7E).
  Styles: "about" = split hero with image + badge (.ab-hero, About.dc.html),
  "faq" = left column head with live search (.faqhead, FAQ.dc.html),
  "plain" = kick + title + lead for generic pages.
  Contact / Resources / Policies keep their tops inside their own sections —
  the mocks fuse those headers with functional content (form / featured card / rail).
{% endcomment %}
<div class="cl">
  {%- if section.settings.show_breadcrumbs -%}
    <section class="wrap">{% render 'cartel-breadcrumbs' %}</section>
  {%- endif -%}

  {%- case section.settings.style -%}
    {%- when 'about' -%}
      <section class="wrap">
        <div class="ab-hero">
          <div class="ab-hero-l">
            {%- if section.settings.eyebrow != blank -%}<span class="kick">{{ section.settings.eyebrow }}</span>{%- endif -%}
            <h1 class="ab-h1">{{ section.settings.heading | default: page.title }}</h1>
            {%- if section.settings.lead != blank -%}<p class="ab-sub">{{ section.settings.lead }}</p>{%- endif -%}
            {%- if section.settings.btn_primary_label != blank or section.settings.btn_secondary_label != blank -%}
              <div class="ab-hero-cta">
                {%- if section.settings.btn_primary_label != blank -%}
                  <a class="btn btn-fill" href="{{ section.settings.btn_primary_link | default: routes.all_products_collection_url }}">
                    {{- section.settings.btn_primary_label -}}
                    <svg class="ic-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
                  </a>
                {%- endif -%}
                {%- if section.settings.btn_secondary_label != blank -%}
                  <a class="btn btn-out" href="{{ section.settings.btn_secondary_link | default: routes.collections_url }}">{{ section.settings.btn_secondary_label }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
          <div class="ab-hero-r">
            <div class="ab-hero-img">
              {%- if section.settings.image -%}
                {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '520,760,1200', loading: 'eager', alt: section.settings.image.alt }}
              {%- endif -%}
            </div>
            {%- if section.settings.show_badge and section.settings.badge_title != blank -%}
              <div class="ab-hero-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.2l2.6 2.6L16 9.5"></path></svg>
                <div>
                  <b>{{ section.settings.badge_title }}</b>
                  <span>{{ section.settings.badge_text }}</span>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </section>

    {%- when 'faq' -%}
      <section class="wrap faqhead">
        {%- if section.settings.eyebrow != blank -%}<span class="kick">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1 class="stitle faqh">{{ section.settings.heading | default: page.title }}</h1>
        {%- if section.settings.lead != blank -%}<p class="lead faqlead">{{ section.settings.lead }}</p>{%- endif -%}
        {%- if section.settings.show_search -%}
          <div class="faqsearch">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
            <input type="search" data-faq-search placeholder="{{ section.settings.search_placeholder | default: 'Search questions' }}" aria-label="Search questions">
          </div>
        {%- endif -%}
      </section>

    {%- else -%}
      <section class="wrap page-plain">
        {%- if section.settings.eyebrow != blank -%}<span class="kick">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1 class="stitle">{{ section.settings.heading | default: page.title }}</h1>
        {%- if section.settings.lead != blank -%}<p class="lead" style="margin-top:16px">{{ section.settings.lead }}</p>{%- endif -%}
      </section>
  {%- endcase -%}
</div>

{% schema %}
{
  "name": "Cartel page hero",
  "tag": "section",
  "class": "cartel-section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "about", "label": "About — split with image" },
        { "value": "faq", "label": "FAQ — head with search" },
        { "value": "plain", "label": "Plain — kick + title + lead" }
      ],
      "default": "plain"
    },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Cartel Lash" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italics render in plum, like the mock's accent words.",
      "default": "Made by lash artists, <em>for</em> lash artists."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead paragraph",
      "default": "Cartel Lash began on the lash bed, years of doing extensions, lifts and tints, and never quite trusting the supplies on the shelf. So we built the shop we always wanted."
    },
    { "type": "header", "content": "Buttons (About style)" },
    { "type": "text", "id": "btn_primary_label", "label": "Primary button label", "default": "Shop the collection" },
    { "type": "url", "id": "btn_primary_link", "label": "Primary button link" },
    { "type": "text", "id": "btn_secondary_label", "label": "Secondary button label", "default": "Meet the brands" },
    { "type": "url", "id": "btn_secondary_link", "label": "Secondary button link" },
    { "type": "header", "content": "Image + badge (About style)" },
    { "type": "image_picker", "id": "image", "label": "Image (4:5)" },
    { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": true },
    { "type": "text", "id": "badge_title", "label": "Badge title", "default": "Tried, tested & true" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "We've used every product we sell" },
    { "type": "header", "content": "Search (FAQ style)" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search questions" }
  ],
  "presets": [{ "name": "Cartel page hero" }]
}
{% endschema %}
