{%- comment -%}
  Cartel Lash — activate account (lane 7D). Centred auth card, Dawn's
  activate_customer_password contract (password + confirmation + decline).
{%- endcomment -%}

<div class="cl">
  <div class="page-width">{% render 'cartel-breadcrumbs', extra_label: 'Account' %}</div>
  <section class="page-width acctpage">
    <div class="authcard">
      <h1 class="af-h">Activate your account.</h1>
      <p class="af-sub">Create a password to finish setting up your account — Thuya pricing unlocks the moment you&rsquo;re in.</p>
      {%- form 'activate_customer_password', class: 'form' -%}
        {%- if form.errors -%}
          <div class="form-alert" role="alert" tabindex="-1" autofocus>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5M12 16h.01"></path></svg>
            <div class="form-alert-b">
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}.
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}
        <div class="field">
          <label class="field-l" for="password">Password</label>
          <div class="pwwrap">
            <input
              class="inp{% if form.errors contains 'password' %} inp-err{% endif %}"
              type="password"
              name="customer[password]"
              id="password"
              autocomplete="new-password"
              placeholder="Create a password"
              {% if form.errors contains 'password' %}
                aria-invalid="true"
              {% endif %}
            >
            <button type="button" class="pwtoggle" aria-label="Show password" aria-pressed="false">
              <svg class="pw-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <svg class="pw-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 3l18 18"></path><path d="M10.6 10.7a3 3 0 0 0 4.1 4.2"></path><path d="M9.8 5.2A9.4 9.4 0 0 1 12 5c6.5 0 10 7 10 7a16.8 16.8 0 0 1-3.3 4M6.1 6.2A16.6 16.6 0 0 0 2 12s3.5 7 10 7a9.3 9.3 0 0 0 3-.5"></path></svg>
            </button>
          </div>
          <span class="field-hint">At least 8 characters.</span>
        </div>
        <div class="field">
          <label class="field-l" for="password_confirmation">Confirm password</label>
          <div class="pwwrap">
            <input
              class="inp{% if form.errors contains 'password_confirmation' %} inp-err{% endif %}"
              type="password"
              name="customer[password_confirmation]"
              id="password_confirmation"
              autocomplete="new-password"
              placeholder="Repeat your password"
              {% if form.errors contains 'password_confirmation' %}
                aria-invalid="true"
              {% endif %}
            >
            <button type="button" class="pwtoggle" aria-label="Show password" aria-pressed="false">
              <svg class="pw-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <svg class="pw-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 3l18 18"></path><path d="M10.6 10.7a3 3 0 0 0 4.1 4.2"></path><path d="M9.8 5.2A9.4 9.4 0 0 1 12 5c6.5 0 10 7 10 7a16.8 16.8 0 0 1-3.3 4M6.1 6.2A16.6 16.6 0 0 0 2 12s3.5 7 10 7a9.3 9.3 0 0 0 3-.5"></path></svg>
            </button>
          </div>
        </div>
        <button class="btn btn-fill w100 af-submit" type="submit">Activate account</button>
        <button class="btn btn-out w100" type="submit" name="decline">Decline invitation</button>
      {%- endform -%}
    </div>
  </section>
</div>

<script>
  (function () {
    document.querySelectorAll('.cl .pwtoggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = btn.closest('.pwwrap').querySelector('input');
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.classList.toggle('showing', show);
        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-activate-account.name",
  "settings": []
}
{% endschema %}
