{% comment %}
  Cartel notification line — lane 7C. cart-notification.js swaps the inner
  markup of #cart-notification-product with the row matching the added line's
  key, so every row here must keep id="cart-notification-product-{key}".
{% endcomment %}
{%- if cart != empty -%}
  {%- for item in cart.items -%}
    {%- liquid
      assign notif_gated = false
      if item.product.vendor == 'Thuya' and customer == nil
        assign notif_gated = true
      endif
    -%}
    <div id="cart-notification-product-{{ item.key }}" class="cart-item">
      <div class="ci-img">
        {%- if item.image -%}
          <img
            class="ci-photo"
            src="{{ item.image | image_url: width: 200 }}"
            alt="{{ item.image.alt | escape }}"
            loading="lazy"
            width="74"
            height="90"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'ci-photo' }}
        {%- endif -%}
      </div>
      <div class="ci-b">
        {%- if item.product.vendor != blank -%}
          <span class="ci-brand">{{ item.product.vendor }}</span>
        {%- endif -%}
        <span class="ci-name">{{ item.product.title | escape }}</span>
        {%- unless item.product.has_only_default_variant -%}
          <span class="ci-var">{{ item.variant.title }}</span>
        {%- endunless -%}
        {%- if item.selling_plan_allocation != null -%}
          <span class="ci-var">{{ item.selling_plan_allocation.selling_plan.name }}</span>
        {%- endif -%}
        <div class="ci-bottom">
          <span class="ci-var">Qty {{ item.quantity }}</span>
          <div class="ci-price">
            {%- if notif_gated -%}
              {% render 'cartel-gate-cta', gate_style: 'card' %}
            {%- elsif item.variant.price == 0 -%}
              {%- comment -%} catalogue price, not post-discount final_price {%- endcomment -%}
              Price on request
            {%- else -%}
              {{ item.final_line_price | money }}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endfor -%}
{%- endif -%}
