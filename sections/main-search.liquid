{% comment %}
  Cartel search — 1:1 with the prototype (Search.dc.html), adapted per the lane
  spec: the toolbar chips are TYPE tabs (All / Products / Articles / Pages via
  the ?type= param) and sorting is a CSS-only <details> popover of server-side
  sort_by links (no cartel-search.js exists — by design).
  Dawn JS contracts kept: <predictive-search>, <main-search>, input[type=search],
  button[type=reset], options[prefix]=last.
{% endcomment %}
<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign terms_esc = search.terms | escape
  assign terms_url = search.terms | url_encode
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign types_joined = search.types | join: ','

  assign type_active = 'all'
  if types_joined == 'product'
    assign type_active = 'product'
  elsif types_joined == 'article'
    assign type_active = 'article'
  elsif types_joined == 'page'
    assign type_active = 'page'
  endif

  assign base_url = routes.search_url | append: '?q=' | append: terms_url | append: '&options%5Bprefix%5D=last'
  assign sorted_url = base_url | append: '&sort_by=' | append: sort_by
-%}

<div class="cl">
  <section class="wrap">
    {% render 'cartel-breadcrumbs', extra_label: 'Search' %}
  </section>

  <section class="wrap srchhead">
    <span class="kick">Search</span>
    <h1 class="stitle srch-h">
      {%- if search.performed and search.terms != blank -%}
        Results for &ldquo;{{ terms_esc }}&rdquo;
      {%- else -%}
        {{ section.settings.heading }}
      {%- endif -%}
    </h1>

    <div class="srch-form-wrap">
      {%- if settings.predictive_search_enabled -%}
        <predictive-search data-loading-text="Loading...">
      {%- endif -%}
      <main-search>
        <form action="{{ routes.search_url }}" method="get" role="search" class="srchbar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
          <input
            type="search"
            id="Search-In-Template"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search products, brands, categories"
            aria-label="Search products, brands, categories"
            {%- if settings.predictive_search_enabled %}
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            {%- endif %}
          >
          <input name="options[prefix]" type="hidden" value="last">
          <button
            type="reset"
            class="srch-clear{% if search.terms == blank %} hidden{% endif %}"
            aria-label="Clear search"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path></svg>
          </button>
        </form>
        {%- if settings.predictive_search_enabled -%}
          <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </main-search>
      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- endif -%}
    </div>

    {%- if section.settings.suggest_terms != blank -%}
      <div class="srch-suggest">
        {%- assign suggests = section.settings.suggest_terms | split: ',' -%}
        {%- for s in suggests -%}
          {%- assign s_stripped = s | strip -%}
          {%- if s_stripped != blank -%}
            <a class="srchchip" href="{{ routes.search_url }}?q={{ s_stripped | url_encode }}&options%5Bprefix%5D=last">{{ s_stripped }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <section class="wrap srchresults">
        <div class="srch-toolbar">
          <span class="srch-count">
            {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
            {%- if search.terms != blank %} for &ldquo;{{ terms_esc }}&rdquo;{% endif -%}
          </span>
          <div class="srch-tools">
            <div class="srch-cats">
              <a class="srchchip{% if type_active == 'all' %} on{% endif %}" href="{{ sorted_url }}">All</a>
              <a class="srchchip{% if type_active == 'product' %} on{% endif %}" href="{{ sorted_url }}&type=product">Products</a>
              <a class="srchchip{% if type_active == 'article' %} on{% endif %}" href="{{ sorted_url }}&type=article">Articles</a>
              <a class="srchchip{% if type_active == 'page' %} on{% endif %}" href="{{ sorted_url }}&type=page">Pages</a>
            </div>
            {%- liquid
              assign sort_label = 'Relevance'
              for option in search.sort_options
                if option.value == sort_by
                  assign sort_label = option.name
                endif
              endfor
              assign type_param = ''
              unless type_active == 'all'
                assign type_param = '&type=' | append: type_active
              endunless
            -%}
            <details class="ssortwrap">
              <summary class="ssortbtn" aria-label="Sort results">
                Sort: {{ sort_label }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M6 9.5l6 6 6-6"></path></svg>
              </summary>
              <div class="ssortmenu">
                {%- for option in search.sort_options -%}
                  <a
                    class="ssortopt{% if option.value == sort_by %} on{% endif %}"
                    href="{{ base_url }}&sort_by={{ option.value }}{{ type_param }}"
                  >
                    {{ option.name }}
                  </a>
                {%- endfor -%}
              </div>
            </details>
          </div>
        </div>

        {%- if search.results_count > 0 -%}
          <div class="srchgrid" id="srchgrid">
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'cartel-card', card_product: item %}
                {%- when 'article' -%}
                  {% render 'article-card', article: item %}
                {%- else -%}
                  <div class="srch-pagecard">
                    <span class="srch-pagecard-k">Page</span>
                    <h3 class="srch-pagecard-h"><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                    <p class="srch-pagecard-x">{{ item.content | strip_html | truncate: 130 }}</p>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            {%- liquid
              assign shown = paginate.current_offset | plus: paginate.page_size | at_most: paginate.items
              assign pct = shown | times: 100 | divided_by: paginate.items
            -%}
            <div class="sload">
              <div class="sload-bar" role="presentation">
                <div class="sload-bar-f" style="width:{{ pct }}%"></div>
              </div>
              <span class="sload-note">Showing {{ shown }} of {{ paginate.items }}</span>
              {%- if paginate.next -%}
                <a class="btn btn-out" href="{{ paginate.next.url }}">Load more results</a>
              {%- endif -%}
              {%- if paginate.previous -%}
                <a class="sload-prev" href="{{ paginate.previous.url }}">Back to previous results</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="srch-empty">
            <div class="srch-empty-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
            </div>
            <div class="srch-empty-t">No results{% if search.terms != blank %} for &ldquo;{{ terms_esc }}&rdquo;{% endif %}</div>
            <p class="srch-empty-p">We couldn’t find a match. Check the spelling, try a more general term, or browse by category.</p>
            {%- if section.settings.suggest_terms != blank -%}
              <div class="srch-empty-sec">
                <div class="srch-empty-h">Popular searches</div>
                <div class="srch-empty-chips">
                  {%- assign populars = section.settings.suggest_terms | split: ',' -%}
                  {%- for s in populars -%}
                    {%- assign s_stripped = s | strip -%}
                    {%- if s_stripped != blank -%}
                      <a class="srch-popchip" href="{{ routes.search_url }}?q={{ s_stripped | url_encode }}&options%5Bprefix%5D=last">{{ s_stripped }}</a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
            {%- if section.settings.suggest_collections.count > 0 -%}
              <div class="srch-empty-sec">
                <div class="srch-empty-h">Browse categories</div>
                <div class="srch-empty-chips">
                  {%- for collection in section.settings.suggest_collections -%}
                    <a class="srchchip" href="{{ collection.url }}">{{ collection.title }}</a>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </section>
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cartel search",
  "tag": "section",
  "class": "cartel-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (before a search runs)",
      "default": "Find your supplies"
    },
    {
      "type": "text",
      "id": "suggest_terms",
      "label": "Suggested search terms (comma-separated)",
      "default": "Lash lift, Adhesive, Bronsun dye, Developer, Shields"
    },
    {
      "type": "collection_list",
      "id": "suggest_collections",
      "label": "Suggested collections (empty state)",
      "limit": 5
    }
  ]
}
{% endschema %}
