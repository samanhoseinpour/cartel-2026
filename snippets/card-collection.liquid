{% comment %}
  Cartel brand card — batch 7A, 1:1 with Brands.dc.html (.bx-card).

  Accepts:
  - card_collection: {Object} collection
  - accent: {String} bx-bronze | bx-blush | bx-mauve | bx-taupe | bx-wine | bx-sage
  - badge: {String} pill over the image (optional)
  - eyebrow: {String} small line over the name (optional)
  - blurb: {String} short copy; falls back to the collection description
  - specs: {String} comma-separated spec pills (optional)
  - card_image: {Object} image override; falls back to the collection image

  Usage:
  {% render 'card-collection', card_collection: collection, accent: 'bx-bronze' %}
{% endcomment %}
{%- liquid
  assign c = card_collection
  assign img = card_image | default: c.featured_image
  assign card_title = c.title | default: 'Brand line'
  assign blurb_text = blurb
  if blurb_text == blank and c != blank
    assign blurb_text = c.description | strip_html | truncate: 140
  endif
-%}
<a class="bx-card {{ accent }}" {% if c != blank %}href="{{ c.url }}"{% endif %}>
  <div class="bx-imgwrap">
    {%- if img -%}
      {{ img | image_url: width: 900 | image_tag: widths: '450,675,900', loading: 'lazy', alt: card_title }}
    {%- else -%}
      <div class="bx-ph">
        {%- if settings.logo -%}
          {{ settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: shop.name }}
        {%- endif -%}
        <span class="bx-ph-l">Photos coming soon</span>
      </div>
    {%- endif -%}
    {%- if badge != blank -%}<span class="bx-badge">{{ badge | escape }}</span>{%- endif -%}
  </div>
  <div class="bx-card-b">
    {%- if eyebrow != blank -%}<span class="bx-eyebrow">{{ eyebrow | escape }}</span>{%- endif -%}
    <h2 class="bx-name">{{ card_title | escape }}</h2>
    {%- if blurb_text != blank -%}<p class="bx-blurb">{{ blurb_text | escape }}</p>{%- endif -%}
    {%- if specs != blank -%}
      <div class="bx-specs">
        {%- assign spec_list = specs | split: ',' -%}
        {%- for spec in spec_list -%}
          {%- assign spec_label = spec | strip -%}
          {%- if spec_label != blank -%}<span class="bx-spec">{{ spec_label | escape }}</span>{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="bx-cardfoot">
      {%- if c != blank -%}
        <span class="bx-count">{{ c.all_products_count }} product{% if c.all_products_count != 1 %}s{% endif %}</span>
      {%- else -%}
        <span class="bx-count">Pick a collection</span>
      {%- endif -%}
      <span class="btn btn-fill btn-sm">
        Shop {{ card_title | escape }}
        <svg class="ic-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
      </span>
    </div>
  </div>
</a>
