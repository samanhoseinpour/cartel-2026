{% comment %}
  Cartel facets — batch 7A rewrite of Dawn's facets snippet, 1:1 with
  Collection.dc.html (.filters rail, .fsheet mobile drawer, .sortwrap popover,
  .activebar chips). Dawn's facets.js contracts are preserved:
    - <facet-filters-form> wrapping every form
    - form ids: FacetFiltersForm (rail), FacetFiltersFormMobile (drawer, inside
      a <menu-drawer>), FacetSortForm (toolbar sort)
    - .js-filter wrappers with stable ids, parents carry ids
    - .active-facets-desktop chips row, .sorting sort wrapper,
      .mobile-facets__open summary (badge auto-refresh)
    - <price-range>, <facet-remove>

  Accepts:
  - results: {Object} Collection or Search object
  - enable_filtering / enable_sorting: {Boolean}
  - part: {String} 'toolbar' | 'active' | 'rail'. The PLP section renders the
    three pieces in different spots. Omit part to render all pieces in
    sequence (plain Dawn-style call, e.g. main-search.liquid).
  - filter_type, paginate: accepted for Dawn call-compat, unused.

  Usage:
  {% render 'facets', results: collection, enable_filtering: true, enable_sorting: true, part: 'toolbar' %}
{% endcomment %}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif

  assign total_active = 0
  for f in results.filters
    if f.type == 'price_range'
      if f.min_value.value != null or f.max_value.value != null
        assign total_active = total_active | plus: 1
      endif
    else
      assign total_active = total_active | plus: f.active_values.size
    endif
  endfor

  assign has_filters = false
  if enable_filtering and results.filters != empty
    assign has_filters = true
  endif

  assign results_count = results.products_count | default: results.results_count

  assign sort_label = ''
  for option in results.sort_options
    if option.value == sort_by
      assign sort_label = option.name
    endif
  endfor

  assign render_all = true
  if part == 'toolbar' or part == 'active' or part == 'rail'
    assign render_all = false
  endif
-%}

{%- capture q_inputs -%}
  {%- if results.terms -%}
    <input type="hidden" name="q" value="{{ results.terms | escape }}">
    <input name="options[prefix]" type="hidden" value="last">
  {%- endif -%}
{%- endcapture -%}

{%- capture check_svg -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4 4L19 7"></path></svg>
{%- endcapture -%}

{%- capture close_svg -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
{%- endcapture -%}

{%- if part == 'toolbar' or render_all -%}
  {%- if has_filters -%}
    <cartel-facets-drawer class="cl-fdraw">
      <menu-drawer class="cl-fdrawer" data-breakpoint="mobile">
        <details id="Details-CartelFilters-{{ section.id }}">
          <summary class="filterbtn mobile-facets__open" role="button" aria-label="Open filters">
            <svg class="ic-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 5h18M6 12h12M10 19h4"></path></svg>
            Filters
            {%- if total_active > 0 %} <span class="fbadge">{{ total_active }}</span>{% endif -%}
          </summary>
          <facet-filters-form class="mobile-facets">
            <aside class="fsheet" role="dialog" aria-modal="true" aria-label="Filters">
              <div class="fsheet-head">
                <span class="fsheet-title">Filters</span>
                <button type="button" class="icbtn" aria-label="Close filters">
                  <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path></svg>
                </button>
              </div>
              <form id="FacetFiltersFormMobile" class="cl-fform">
                {{ q_inputs }}
                <div class="fsheet-body" id="FacetsWrapperMobile">
                  {%- if enable_sorting -%}
                    <div class="js-filter" id="Filter-Mobile-Sort-{{ section.id }}" hidden>
                      <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">
                    </div>
                  {%- endif -%}
                  {%- for filter in results.filters -%}
                    {%- case filter.type -%}
                      {%- when 'boolean' -%}
                        {%- liquid
                          assign bool_v = filter.values.first
                          for v in filter.values
                            if v.value == '1'
                              assign bool_v = v
                            endif
                          endfor
                        -%}
                        <div class="fgroup{% if forloop.first %} first{% endif %} js-filter" id="Filter-Mobile-{{ filter.param_name | escape }}-{{ section.id }}">
                          <div class="fgroup-h">{{ filter.label | escape }}</div>
                          <label class="fswitch-row facets-wrap">
                            <span class="fswitch-l">{% if bool_v.label == 'In stock' %}In stock only{% else %}{{ bool_v.label | escape }}{% endif %}</span>
                            <input
                              type="checkbox"
                              class="visually-hidden"
                              name="{{ bool_v.param_name }}"
                              value="{{ bool_v.value }}"
                              id="Input-Mobile-{{ forloop.index }}-0-{{ section.id }}"
                              {% if bool_v.active %}checked{% endif %}
                            >
                            <span class="fswitch{% if bool_v.active %} fson{% endif %}" aria-hidden="true"><span class="fswitch-k"></span></span>
                          </label>
                        </div>
                      {%- when 'price_range' -%}
                        <div class="fgroup{% if forloop.first %} first{% endif %} js-filter" id="Filter-Mobile-{{ filter.param_name | escape }}-{{ section.id }}">
                          <div class="fgroup-h">{{ filter.label | escape }}</div>
                          {% render 'price-facet', filter: filter, id_prefix: 'Mobile-' %}
                        </div>
                      {%- when 'list' -%}
                        {%- liquid
                          assign maxlen = 0
                          for v in filter.values
                            assign l = v.label | strip
                            if l.size > maxlen
                              assign maxlen = l.size
                            endif
                          endfor
                          assign use_pills = false
                          if maxlen <= 4
                            assign use_pills = true
                          elsif filter.param_name contains 'option' and maxlen <= 8
                            assign use_pills = true
                          endif
                        -%}
                        <div class="fgroup{% if forloop.first %} first{% endif %} js-filter" id="Filter-Mobile-{{ filter.param_name | escape }}-{{ section.id }}">
                          <div class="fgroup-h">{{ filter.label | escape }}</div>
                          {%- if use_pills -%}
                            <div class="fpills facets-wrap">
                              {%- for value in filter.values -%}
                                <label class="fpill{% if value.active %} on{% endif %}">
                                  <input
                                    type="checkbox"
                                    class="visually-hidden"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value | escape }}"
                                    id="Input-Mobile-{{ forloop.parentloop.index }}-{{ forloop.index }}-{{ section.id }}"
                                    {% if value.active %}checked{% endif %}
                                  >
                                  {{ value.label | escape }}
                                </label>
                              {%- endfor -%}
                            </div>
                          {%- else -%}
                            <div class="fopts facets-wrap">
                              {%- for value in filter.values -%}
                                <label class="fopt">
                                  <input
                                    type="checkbox"
                                    class="visually-hidden"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value | escape }}"
                                    id="Input-Mobile-{{ forloop.parentloop.index }}-{{ forloop.index }}-{{ section.id }}"
                                    {% if value.active %}checked{% endif %}
                                  >
                                  <span class="fbox{% if value.active %} on{% endif %}" aria-hidden="true">{{ check_svg }}</span>
                                  <span class="fopt-l">{{ value.label | escape }}</span>
                                  <span class="fopt-c">{{ value.count }}</span>
                                </label>
                              {%- endfor -%}
                            </div>
                          {%- endif -%}
                        </div>
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
                <div class="fsheet-foot js-filter" id="Filter-Mobile-Foot-{{ section.id }}">
                  {%- if total_active > 0 -%}
                    <facet-remove class="js-facet-remove"><a href="{{ results_url }}" class="btn btn-out">Clear all</a></facet-remove>
                  {%- endif -%}
                  <button type="button" class="btn btn-fill w100">Show {{ results_count }} result{% if results_count != 1 %}s{% endif %}</button>
                </div>
              </form>
            </aside>
          </facet-filters-form>
        </details>
      </menu-drawer>
    </cartel-facets-drawer>
  {%- elsif enable_sorting -%}
    {%- comment -%}
      facets.js renderAdditionalElements unconditionally dereferences
      #FacetFiltersFormMobile inside a <menu-drawer>; keep a hidden stub when
      the drawer isn't rendered so AJAX sorting doesn't throw.
    {%- endcomment -%}
    <menu-drawer class="cl-fdrawer-stub" data-breakpoint="mobile" hidden>
      <details><summary aria-hidden="true" tabindex="-1"></summary>
        <facet-filters-form><form id="FacetFiltersFormMobile">{{ q_inputs }}</form></facet-filters-form>
      </details>
    </menu-drawer>
  {%- endif -%}

  {%- if enable_sorting -%}
    <cartel-sort class="sortwrap">
      <facet-filters-form class="cl-sortff">
        <form id="FacetSortForm">
          {{ q_inputs }}
          <div class="sorting">
            <select name="sort_by" id="SortBy" class="cl-sortsel" aria-label="Sort by">
              {%- for option in results.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
            <button type="button" class="sortbtn" aria-expanded="false" aria-haspopup="listbox">
              <svg class="ic-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M7 5v14M7 19l-3-3M7 5l3 3M17 19V5M17 5l3 3M17 19l-3-3"></path></svg>
              Sort:&nbsp;<span class="cl-sortlabel">{{ sort_label | escape }}</span>
              <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M6 9.5l6 6 6-6"></path></svg>
            </button>
            <div class="sortmenu" role="listbox" aria-label="Sort by">
              {%- for option in results.sort_options -%}
                <button type="button" class="sortopt{% if option.value == sort_by %} on{% endif %}" role="option" aria-selected="{% if option.value == sort_by %}true{% else %}false{% endif %}" data-value="{{ option.value | escape }}">
                  {{ option.name | escape }}
                  {%- if option.value == sort_by -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          </div>
        </form>
      </facet-filters-form>
    </cartel-sort>
  {%- endif -%}
{%- endif -%}

{%- if part == 'active' or render_all -%}
  <div class="activebar active-facets active-facets-desktop">
    {%- for filter in results.filters -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != null or filter.max_value.value != null -%}
          <facet-remove class="js-facet-remove">
            <a href="{{ filter.url_to_remove }}" class="fchip">
              {{- filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}{{ close_svg }}<span class="visually-hidden">Remove filter</span>
            </a>
          </facet-remove>
        {%- endif -%}
      {%- else -%}
        {%- for value in filter.active_values -%}
          <facet-remove class="js-facet-remove">
            <a href="{{ value.url_to_remove }}" class="fchip">
              {{- value.label | escape }}{{ close_svg }}<span class="visually-hidden">Remove filter</span>
            </a>
          </facet-remove>
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if total_active > 0 -%}
      <facet-remove class="js-facet-remove"><a href="{{ results_url }}" class="clearall">Clear all</a></facet-remove>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if part == 'rail' or render_all -%}
  {%- if has_filters -%}
    <aside class="filters">
      <facet-filters-form class="cl-railff">
        <form id="FacetFiltersForm" class="cl-fform-rail">
          {{ q_inputs }}
          <div id="FacetsWrapperDesktop">
            <div class="fhead js-filter" id="Filter-Head-{{ section.id }}">
              <span class="fhead-t">Filters</span>
              {%- if total_active > 0 -%}
                <facet-remove class="js-facet-remove"><a href="{{ results_url }}" class="fhead-clear">Clear all</a></facet-remove>
              {%- endif -%}
            </div>
            {%- for filter in results.filters -%}
              {%- case filter.type -%}
                {%- when 'boolean' -%}
                  {%- liquid
                    assign bool_v = filter.values.first
                    for v in filter.values
                      if v.value == '1'
                        assign bool_v = v
                      endif
                    endfor
                  -%}
                  <div class="fgroup{% if forloop.first %} first{% endif %} js-filter" id="Filter-{{ filter.param_name | escape }}-{{ section.id }}">
                    <div class="fgroup-h">{{ filter.label | escape }}</div>
                    <label class="fswitch-row facets-wrap">
                      <span class="fswitch-l">{% if bool_v.label == 'In stock' %}In stock only{% else %}{{ bool_v.label | escape }}{% endif %}</span>
                      <input
                        type="checkbox"
                        class="visually-hidden"
                        name="{{ bool_v.param_name }}"
                        value="{{ bool_v.value }}"
                        id="Input-{{ forloop.index }}-0-{{ section.id }}"
                        {% if bool_v.active %}checked{% endif %}
                      >
                      <span class="fswitch{% if bool_v.active %} fson{% endif %}" aria-hidden="true"><span class="fswitch-k"></span></span>
                    </label>
                  </div>
                {%- when 'price_range' -%}
                  <div class="fgroup{% if forloop.first %} first{% endif %} js-filter" id="Filter-{{ filter.param_name | escape }}-{{ section.id }}">
                    <div class="fgroup-h">{{ filter.label | escape }}</div>
                    {% render 'price-facet', filter: filter, id_prefix: 'Desktop-' %}
                  </div>
                {%- when 'list' -%}
                  {%- liquid
                    assign maxlen = 0
                    for v in filter.values
                      assign l = v.label | strip
                      if l.size > maxlen
                        assign maxlen = l.size
                      endif
                    endfor
                    assign use_pills = false
                    if maxlen <= 4
                      assign use_pills = true
                    elsif filter.param_name contains 'option' and maxlen <= 8
                      assign use_pills = true
                    endif
                  -%}
                  <div class="fgroup{% if forloop.first %} first{% endif %} js-filter" id="Filter-{{ filter.param_name | escape }}-{{ section.id }}">
                    <div class="fgroup-h">{{ filter.label | escape }}</div>
                    {%- if use_pills -%}
                      <div class="fpills facets-wrap">
                        {%- for value in filter.values -%}
                          <label class="fpill{% if value.active %} on{% endif %}">
                            <input
                              type="checkbox"
                              class="visually-hidden"
                              name="{{ value.param_name }}"
                              value="{{ value.value | escape }}"
                              id="Input-{{ forloop.parentloop.index }}-{{ forloop.index }}-{{ section.id }}"
                              {% if value.active %}checked{% endif %}
                            >
                            {{ value.label | escape }}
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      <div class="fopts facets-wrap">
                        {%- for value in filter.values -%}
                          <label class="fopt">
                            <input
                              type="checkbox"
                              class="visually-hidden"
                              name="{{ value.param_name }}"
                              value="{{ value.value | escape }}"
                              id="Input-{{ forloop.parentloop.index }}-{{ forloop.index }}-{{ section.id }}"
                              {% if value.active %}checked{% endif %}
                            >
                            <span class="fbox{% if value.active %} on{% endif %}" aria-hidden="true">{{ check_svg }}</span>
                            <span class="fopt-l">{{ value.label | escape }}</span>
                            <span class="fopt-c">{{ value.count }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </form>
      </facet-filters-form>
    </aside>
  {%- endif -%}
{%- endif -%}
