{% comment %}
  Cartel price facet — batch 7A. Dawn's <price-range> min/max pair restyled to
  the Cartel pill fields (the prototype's checkbox buckets can't map onto
  Shopify's single gte/lte price filter, so the range stays).

  Accepts:
  - filter: {Object} price_range filter
  - id_prefix: {String} keeps input ids unique between the rail and the drawer
{% endcomment %}
<price-range class="cl-price">
  <label class="cl-price-f">
    <span class="visually-hidden">From</span>
    <span class="cl-price-cur" aria-hidden="true">{{ cart.currency.symbol }}</span>
    <input
      class="cl-price-in"
      name="{{ filter.min_value.param_name }}"
      id="Price-GTE-{{ id_prefix }}{{ section.id }}"
      {%- if filter.min_value.value %}
      value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
      {%- endif %}
      type="text"
      inputmode="decimal"
      placeholder="0"
      data-min="0"
      data-max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
    >
  </label>
  <span class="cl-price-dash" aria-hidden="true">–</span>
  <label class="cl-price-f">
    <span class="visually-hidden">To</span>
    <span class="cl-price-cur" aria-hidden="true">{{ cart.currency.symbol }}</span>
    <input
      class="cl-price-in"
      name="{{ filter.max_value.param_name }}"
      id="Price-LTE-{{ id_prefix }}{{ section.id }}"
      {%- if filter.max_value.value %}
      value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
      {%- endif %}
      type="text"
      inputmode="decimal"
      placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
      data-min="0"
      data-max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
    >
  </label>
</price-range>
