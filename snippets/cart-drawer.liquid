{% comment %}
  Cartel cart drawer — lane 7C, 1:1 with the prototype drawer (Cart.dc.html).
  Renders only when settings.cart_type == 'drawer' (theme.liquid).
  Dawn mechanics preserved: <cart-drawer> / #CartDrawer / #CartDrawer-Overlay /
  .drawer__inner / .drawer__inner-empty / .drawer__close / <cart-drawer-items> /
  #CartDrawer-CartItems .js-contents / .cart-drawer__footer / #Drawer-quantity-{n} /
  #CartDrawer-Item-{n} / live regions / #CartDrawer-CartErrors / #CartDrawer-Checkout.
  Skin lives in assets/cartel-conversion.css (loads on every template).

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

{%- liquid
  assign dw_gate_count = 0
  assign dw_gated_subtotal = 0
  for item in cart.items
    if item.product.vendor == 'Thuya' and customer == nil
      assign dw_gate_count = dw_gate_count | plus: 1
      assign dw_gated_subtotal = dw_gated_subtotal | plus: item.final_line_price
    endif
  endfor
  assign dw_subtotal = cart.items_subtotal_price | minus: dw_gated_subtotal
  assign dw_threshold = 15000
  assign dw_remaining = dw_threshold | minus: cart.total_price
  assign dw_free = false
  if cart.total_price >= dw_threshold
    assign dw_free = true
  endif
  assign dw_pct = cart.total_price | times: 100 | divided_by: dw_threshold
  if dw_pct > 100
    assign dw_pct = 100
  endif
-%}

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="cl dw drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="Your bag"
      tabindex="-1"
    >
      <div class="dw-head">
        <h2 class="dw-title">Your bag{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</h2>
        <button
          class="icbtn drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="Close"
        >
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path></svg>
        </button>
      </div>

      <div class="drawer__inner-empty">
        <div class="dw-empty">
          <div class="stitle">Your bag is empty</div>
          <p>Add your studio essentials to get started.</p>
          <a class="btn btn-fill" href="{{ routes.all_products_collection_url }}">Start shopping</a>
          <button class="dw-cont" type="button" onclick="this.closest('cart-drawer').close()">Continue shopping</button>
        </div>
      </div>

      <cart-drawer-items
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        {%- if cart != empty -%}
          <div class="dw-ship">
            <div class="dw-ship-t">
              {%- if dw_free -%}
                You've earned free shipping
              {%- else -%}
                You're <b>{{ dw_remaining | money }}</b> away from free shipping
              {%- endif -%}
            </div>
            <div class="dw-bar"><div class="dw-bar-f" style="width: {{ dw_pct }}%"></div></div>
          </div>
        {%- endif -%}
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents dw-form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="dw-items js-contents">
            {%- for item in cart.items -%}
              {%- liquid
                assign dw_line_gated = false
                if item.product.vendor == 'Thuya' and customer == nil
                  assign dw_line_gated = true
                endif
              -%}
              <div id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="ci cart-item">
                <div class="ci-img">
                  <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                    {%- if item.image -%}
                      <img
                        class="ci-photo"
                        src="{{ item.image | image_url: width: 200 }}"
                        alt="{{ item.image.alt | escape }}"
                        loading="lazy"
                        width="74"
                        height="90"
                      >
                    {%- else -%}
                      {% render 'cartel-photo-placeholder', ph_size: 'sm', ph_class: 'ci-photo' %}
                    {%- endif -%}
                  </a>
                </div>
                <div class="ci-b">
                  {%- if item.product.vendor != blank -%}
                    <span class="ci-brand">{{ item.product.vendor }}</span>
                  {%- endif -%}
                  <a class="ci-name cart-item__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <span class="ci-var">{{ item.variant.title }}</span>
                  {%- endunless -%}
                  {%- if item.selling_plan_allocation != null -%}
                    <span class="ci-var">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                  {%- endif -%}
                  <div class="ci-bottom">
                    {%- comment -%} Bundles child lines report these false — see main-cart-items {%- endcomment -%}
                    {%- comment -%}
                      allow_false is required: Liquid's `default` substitutes on
                      nil, "" AND false, so without it a bundle child reporting
                      can_update_quantity == false read back as true and every
                      `== false` guard below was dead code.
                    {%- endcomment -%}
                    {%- assign can_update_quantity = item.instructions.can_update_quantity
                      | default: true, allow_false: true
                    -%}
                    {%- comment -%}
                      Real stock ceiling for the stepper. quantity_rule.max is
                      Shopify's B2B quantity rule, NOT inventory, so on its own it
                      leaves + uncapped and every over-stock click round-trips to
                      /cart/change only to be clamped and answered with an error.
                      Only variants that actually track stock and refuse oversell
                      get a cap. This is a render-time snapshot, so the server
                      check in cart.js stays the authority — this just stops the
                      pointless click.
                    {%- endcomment -%}
                    {%- assign qty_cap = item.variant.quantity_rule.max -%}
                    {%- if item.variant.inventory_management == 'shopify'
                      and item.variant.inventory_policy == 'deny'
                    -%}
                      {%- assign stock_cap = item.variant.inventory_quantity -%}
                      {%- comment -%} oversold lines report negative; a max below min is invalid {%- endcomment -%}
                      {%- if stock_cap < 0 -%}
                        {%- assign stock_cap = 0 -%}
                      {%- endif -%}
                      {%- if qty_cap == null or stock_cap < qty_cap -%}
                        {%- assign qty_cap = stock_cap -%}
                      {%- endif -%}
                    {%- endif -%}
                    <quantity-input class="qty">
                      <button class="qbtn quantity__button" name="minus" type="button" {% if can_update_quantity == false %}disabled{% endif %}>
                        <span class="visually-hidden">Decrease quantity for {{ item.product.title | escape }}</span>
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14"></path></svg>
                      </button>
                      {%- comment -%}
                        min="0" is load-bearing, not sloppiness. stepDown() clamps at min, so
                        min="1" would make "−" a no-op at the last unit — no value change, no
                        change event, no removal — and cart.js:validateQuantity routes 0 to the
                        same /cart/change delete that <cart-remove-button> posts. It is also the
                        native guard that keeps the spinner and ArrowDown out of negatives, and
                        validateQtyRules (global.js) reads input.min, so raising it to data-min
                        would additionally dim "−" at qty 1 and advertise a dead control. The real
                        quantity rule stays in data-min and is still enforced above 0.
                      {%- endcomment -%}
                      <input
                        class="qn"
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        data-quantity-variant-id="{{ item.variant.id }}"
                        data-quantity-line-key="{{ item.key }}"
                        {% # theme-check-disable %}
                        data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                        min="0"
                        data-min="{{ item.variant.quantity_rule.min }}"
                        {% if qty_cap != null %}
                          max="{{ qty_cap }}"
                        {% endif %}
                        step="{{ item.variant.quantity_rule.increment }}"
                        {% # theme-check-enable %}
                        aria-label="Quantity for {{ item.product.title | escape }}"
                        id="Drawer-quantity-{{ item.index | plus: 1 }}"
                        data-index="{{ item.index | plus: 1 }}"
                        {% if can_update_quantity == false %}disabled{% endif %}
                      >
                      <button class="qbtn quantity__button" name="plus" type="button" {% if can_update_quantity == false %}disabled{% endif %}>
                        <span class="visually-hidden">Increase quantity for {{ item.product.title | escape }}</span>
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                      </button>
                    </quantity-input>
                    <div class="ci-price">
                      {%- if dw_line_gated -%}
                        {% render 'cartel-gate-cta', gate_style: 'card' %}
                      {%- elsif item.variant.price == 0 -%}
                        {%- comment -%} catalogue price, not post-discount final_price {%- endcomment -%}
                        Price on request
                      {%- else -%}
                        {{ item.final_line_price | money }}
                      {%- endif -%}
                    </div>
                  </div>
                  <div class="cart-item__error" id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}" role="alert">
                    <small class="cart-item__error-text"></small>
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                  </div>
                </div>
                {%- assign can_remove = item.instructions.can_remove | default: true, allow_false: true -%}
                <cart-remove-button
                  id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                  data-index="{{ item.index | plus: 1 }}"
                  {% if can_remove == false %}class="hidden"{% endif %}
                >
                  <button type="button" class="ci-rm" aria-label="Remove {{ item.product.title | escape }}">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M9.5 7V5h5v2M6.5 7l.8 13h9.4l.8-13"></path></svg>
                    Remove
                  </button>
                </cart-remove-button>
                {%- render 'loading-spinner' -%}
              </div>
            {%- endfor -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              Loading&hellip;
            </p>
          </div>
          <div id="CartDrawer-CartErrors" class="dw-errs" role="alert"></div>
        </form>
        {%- comment -%}
          "You may also like" strip. This exact node — inside <cart-drawer-items>,
          outside #CartDrawer-Form — is the only one every re-render path rebuilds:
            qty / remove   cart.js:223 + cart-drawer.js:129 -> .drawer__inner.innerHTML
            add from a PDP cart-drawer.js:83                -> #CartDrawer.innerHTML
            cartUpdate     cart.js:118                      -> replaceWith cart-drawer-items
            + Add          cartel-conversion.js             -> replaceWith cart-drawer-items
          A sibling BETWEEN </cart-drawer-items> and .cart-drawer__footer misses the
          third path and would keep offering a product already in the bag. Inside
          #CartDrawer-CartItems it would scroll away with the line items, and a
          <form> cannot nest inside #CartDrawer-Form.
        {%- endcomment -%}
        {%- render 'cartel-drawer-upsell' -%}
      </cart-drawer-items>

      {%- comment -%}
        Announces quick-adds from the strip. It has to live out here:
        #CartDrawer-LiveRegionText sits inside #CartDrawer-CartItems, which every
        add destroys and recreates, and a live region that is removed and
        re-inserted already holding its text is not reliably announced. This node
        is a direct child of .drawer__inner, which the quick-add path never
        replaces, so it is in the accessibility tree before the text changes.
      {%- endcomment -%}
      <p id="CartDrawer-UpsellStatus" class="visually-hidden" role="status" aria-live="polite"></p>

      <div class="cart-drawer__footer dw-foot">
        {%- if cart != empty -%}
          {%- if dw_gate_count > 0 -%}
            <div class="dw-lock">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
              <span><b>{{ dw_gate_count }} Thuya item{% if dw_gate_count != 1 %}s{% endif %} priced after login.</b> Log in to reveal pro pricing and check out.</span>
            </div>
          {%- endif -%}
          <div class="dw-sub">
            <span class="dw-sub-l">Subtotal</span>
            <span class="dw-sub-v">{{ dw_subtotal | money }}{% if dw_gate_count > 0 %}+{% endif %}</span>
          </div>
          <div class="dw-note">Taxes &amp; shipping calculated at checkout</div>
          {%- if dw_gate_count > 0 -%}
            <a class="btn btn-fill w100" href="{{ routes.account_login_url }}">Log in to checkout</a>
          {%- else -%}
            <button
              type="submit"
              id="CartDrawer-Checkout"
              class="btn btn-fill w100"
              name="checkout"
              form="CartDrawer-Form"
            >
              Checkout
            </button>
          {%- endif -%}
          <button class="dw-cont" type="button" onclick="this.closest('cart-drawer').close()">Continue shopping</button>
        {%- endif -%}
      </div>
    </div>
  </div>
</cart-drawer>
