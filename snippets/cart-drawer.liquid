{% comment %}
  Cartel cart drawer — lane 7C, 1:1 with the prototype drawer (Cart.dc.html).
  Renders only when settings.cart_type == 'drawer' (theme.liquid).
  Dawn mechanics preserved: <cart-drawer> / #CartDrawer / #CartDrawer-Overlay /
  .drawer__inner / .drawer__inner-empty / .drawer__close / <cart-drawer-items> /
  #CartDrawer-CartItems .js-contents / .cart-drawer__footer / #Drawer-quantity-{n} /
  #CartDrawer-Item-{n} / live regions / #CartDrawer-CartErrors / #CartDrawer-Checkout.
  Skin lives in assets/cartel-conversion.css (loads on every template).

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

{%- liquid
  assign dw_gate_count = 0
  assign dw_gated_subtotal = 0
  for item in cart.items
    if item.product.vendor == 'Thuya' and customer == nil
      assign dw_gate_count = dw_gate_count | plus: 1
      assign dw_gated_subtotal = dw_gated_subtotal | plus: item.final_line_price
    endif
  endfor
  assign dw_subtotal = cart.items_subtotal_price | minus: dw_gated_subtotal
  assign dw_threshold = 15000
  assign dw_remaining = dw_threshold | minus: cart.total_price
  assign dw_free = false
  if cart.total_price >= dw_threshold
    assign dw_free = true
  endif
  assign dw_pct = cart.total_price | times: 100 | divided_by: dw_threshold
  if dw_pct > 100
    assign dw_pct = 100
  endif
-%}

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="cl dw drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="Your bag"
      tabindex="-1"
    >
      <div class="dw-head">
        <h2 class="dw-title">Your bag{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</h2>
        <button
          class="icbtn drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="Close"
        >
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path></svg>
        </button>
      </div>

      <div class="drawer__inner-empty">
        <div class="dw-empty">
          <div class="stitle">Your bag is empty</div>
          <p>Add your studio essentials to get started.</p>
          <a class="btn btn-fill" href="{{ routes.all_products_collection_url }}">Start shopping</a>
          <button class="dw-cont" type="button" onclick="this.closest('cart-drawer').close()">Continue shopping</button>
        </div>
      </div>

      <cart-drawer-items
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        {%- if cart != empty -%}
          <div class="dw-ship">
            <div class="dw-ship-t">
              {%- if dw_free -%}
                You've earned free shipping
              {%- else -%}
                You're <b>{{ dw_remaining | money }}</b> away from free shipping
              {%- endif -%}
            </div>
            <div class="dw-bar"><div class="dw-bar-f" style="width: {{ dw_pct }}%"></div></div>
          </div>
        {%- endif -%}
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents dw-form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="dw-items js-contents">
            {%- for item in cart.items -%}
              {%- liquid
                assign dw_line_gated = false
                if item.product.vendor == 'Thuya' and customer == nil
                  assign dw_line_gated = true
                endif
              -%}
              <div id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="ci cart-item">
                <div class="ci-img">
                  <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                    {%- if item.image -%}
                      <img
                        class="ci-photo"
                        src="{{ item.image | image_url: width: 200 }}"
                        alt="{{ item.image.alt | escape }}"
                        loading="lazy"
                        width="74"
                        height="90"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'ci-photo' }}
                    {%- endif -%}
                  </a>
                </div>
                <div class="ci-b">
                  {%- if item.product.vendor != blank -%}
                    <span class="ci-brand">{{ item.product.vendor }}</span>
                  {%- endif -%}
                  <a class="ci-name cart-item__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <span class="ci-var">{{ item.variant.title }}</span>
                  {%- endunless -%}
                  {%- if item.selling_plan_allocation != null -%}
                    <span class="ci-var">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                  {%- endif -%}
                  <div class="ci-bottom">
                    <quantity-input class="qty">
                      <button class="qbtn" name="minus" type="button">
                        <span class="visually-hidden">Decrease quantity for {{ item.product.title | escape }}</span>
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14"></path></svg>
                      </button>
                      <input
                        class="qn"
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        data-quantity-variant-id="{{ item.variant.id }}"
                        data-quantity-line-key="{{ item.key }}"
                        {% # theme-check-disable %}
                        data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                        min="0"
                        data-min="{{ item.variant.quantity_rule.min }}"
                        {% if item.variant.quantity_rule.max != null %}
                          max="{{ item.variant.quantity_rule.max }}"
                        {% endif %}
                        step="{{ item.variant.quantity_rule.increment }}"
                        {% # theme-check-enable %}
                        aria-label="Quantity for {{ item.product.title | escape }}"
                        id="Drawer-quantity-{{ item.index | plus: 1 }}"
                        data-index="{{ item.index | plus: 1 }}"
                      >
                      <button class="qbtn" name="plus" type="button">
                        <span class="visually-hidden">Increase quantity for {{ item.product.title | escape }}</span>
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                      </button>
                    </quantity-input>
                    <div class="ci-price">
                      {%- if dw_line_gated -%}
                        {% render 'cartel-gate-cta', gate_style: 'card' %}
                      {%- elsif item.final_price == 0 -%}
                        Price on request
                      {%- else -%}
                        {{ item.final_line_price | money }}
                      {%- endif -%}
                    </div>
                  </div>
                  <div class="cart-item__error" id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}" role="alert">
                    <small class="cart-item__error-text"></small>
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                  </div>
                </div>
                <cart-remove-button
                  id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                  data-index="{{ item.index | plus: 1 }}"
                >
                  <button type="button" class="ci-rm" aria-label="Remove {{ item.product.title | escape }}">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M9.5 7V5h5v2M6.5 7l.8 13h9.4l.8-13"></path></svg>
                    Remove
                  </button>
                </cart-remove-button>
                {%- render 'loading-spinner' -%}
              </div>
            {%- endfor -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              Loading&hellip;
            </p>
          </div>
          <div id="CartDrawer-CartErrors" class="dw-errs" role="alert"></div>
        </form>
      </cart-drawer-items>

      <div class="cart-drawer__footer dw-foot">
        {%- if cart != empty -%}
          {%- if dw_gate_count > 0 -%}
            <div class="dw-lock">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
              <span><b>{{ dw_gate_count }} Thuya item{% if dw_gate_count != 1 %}s{% endif %} priced after login.</b> Log in to reveal pro pricing and check out.</span>
            </div>
          {%- endif -%}
          <div class="dw-sub">
            <span class="dw-sub-l">Subtotal</span>
            <span class="dw-sub-v">{{ dw_subtotal | money }}{% if dw_gate_count > 0 %}+{% endif %}</span>
          </div>
          <div class="dw-note">Taxes &amp; shipping calculated at checkout</div>
          {%- if dw_gate_count > 0 -%}
            <a class="btn btn-fill w100" href="{{ routes.account_login_url }}">Log in to checkout</a>
          {%- else -%}
            <button
              type="submit"
              id="CartDrawer-Checkout"
              class="btn btn-fill w100"
              name="checkout"
              form="CartDrawer-Form"
            >
              Checkout
            </button>
          {%- endif -%}
          <button class="dw-cont" type="button" onclick="this.closest('cart-drawer').close()">Continue shopping</button>
        {%- endif -%}
      </div>
    </div>
  </div>
</cart-drawer>
