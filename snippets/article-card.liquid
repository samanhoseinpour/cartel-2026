{% comment %}
  Cartel article card — 1:1 with the prototype (.bl-card in Blog.dc.html).
  Categories are article TAGS (Technique / Education / Business / Supplies).

  Accepts:
  - article: {Object} article to render (required)
  - show_cat: {Boolean} show the category pill on the image (default true)

  Usage: {% render 'article-card', article: article %}
{% endcomment %}
{%- liquid
  assign cl_cats = 'Technique,Education,Business,Supplies' | split: ','
  assign cat_label = ''
  for t in article.tags
    assign td = t | downcase
    for c in cl_cats
      assign cd = c | downcase
      if td == cd
        assign cat_label = c
        break
      endif
    endfor
    if cat_label != blank
      break
    endif
  endfor

  assign initials = ''
  assign author_words = article.author | strip | split: ' '
  # `split: ' '` on a name with a double space yields an empty token, so
  # "Joan  Wong" produced the avatar "J". Skip blanks and stop at two.
  for w in author_words
    if w == blank
      continue
    endif
    assign letter = w | slice: 0, 1 | upcase
    assign initials = initials | append: letter
    if initials.size >= 2
      break
    endif
  endfor
  if initials == blank
    assign initials = 'CL'
  endif

  # ONE strip_html pass over the body, reused for BOTH the read-time estimate and
  # the excerpt fallback below.
  #
  # The expensive part of the original was never strip_html — it was `split: ' '`
  # allocating a multi-thousand-element word array and then discarding all of it
  # except `.size`, once per card (24 times on a 12-card index). strip_html is a
  # single string pass with no array allocation, so dropping only the split keeps
  # nearly all of the win.
  #
  # Divide STRIPPED TEXT, not raw HTML: these posts were imported from Word and
  # wrap every text run in <span style="font-weight: 400;">, which works out at
  # ~10.9 HTML chars per word against ~5.5 for clean prose. Dividing raw markup
  # over-reported all 70 articles by 1.7-3.5x (one 1,826-word post read "22 min"
  # instead of 9). On stripped text ~1100 chars ≈ 200 words ≈ 1 minute holds.
  # Set custom.read_minutes on an article to pin an exact figure; `.value` is
  # required or the comparison silently comes back an object and never fires.
  assign body_text = article.content | strip_html
  assign read_mins = article.metafields.custom.read_minutes.value
  unless read_mins > 0
    assign read_mins = body_text.size | divided_by: 1100 | at_least: 1
  endunless

  assign card_excerpt = article.excerpt | strip_html
  if card_excerpt == blank
    assign card_excerpt = body_text
  endif

  assign show_cat_pill = true
  if show_cat == false or cat_label == blank
    assign show_cat_pill = false
  endif
-%}
<article class="bl-card">
  <div class="bl-card-img">
    {%- if show_cat_pill -%}<span class="bl-card-cat">{{ cat_label }}</span>{%- endif -%}
    <a href="{{ article.url }}" aria-label="{{ article.title | escape }}" tabindex="-1">
      {%- if article.image -%}
        {{
          article.image
          | image_url: width: 900
          | image_tag:
            class: 'bl-card-photo',
            widths: '400,600,800,1000',
            sizes: '(min-width: 1040px) 400px, (min-width: 760px) 50vw, 100vw',
            loading: 'lazy',
            alt: article.title
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'bl-card-photo' }}
      {%- endif -%}
    </a>
  </div>
  <h3 class="bl-card-h"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
  {%- comment -%}
    excerpt_or_content falls back to the FULL body when an article has no excerpt
    — and the imported posts have none — so this used to be a SECOND whole-body
    strip_html per card. card_excerpt above reuses the single pass already done
    for the read-time estimate.
  {%- endcomment -%}
  <p class="bl-card-x">{{ card_excerpt | truncate: 150 }}</p>
  <div class="bl-card-meta">
    <div class="bl-avatar sm" aria-hidden="true">{{ initials }}</div>
    <div class="bl-meta-txt">
      <span class="bl-meta-by">{{ article.author }}</span>
      <span class="bl-meta-sub">
        {{- article.published_at | date: '%b %-d, %Y' }} · {{ read_mins }} min read
      </span>
    </div>
  </div>
</article>
