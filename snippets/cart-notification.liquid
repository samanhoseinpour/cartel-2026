{% comment %}
  Cartel "added to bag" notification — lane 7C (cart_type: notification).
  Dawn mechanics preserved: <cart-notification>, #cart-notification with
  animate/active classes from component-cart-notification.css,
  #cart-notification-product and #cart-notification-button (both re-rendered
  from sections after an add), close buttons = button[type="button"].
  No checkout shortcut here: gated (Thuya, logged-out) carts must land on the
  cart page, which enforces the login CTA. Skin: assets/cartel-conversion.css.

  Accepts:
  - color_scheme: {String} (optional)
  - desktop_menu_type: {String} (optional)

  Usage:
  {% render 'cart-notification' %}
{% endcomment %}

<cart-notification>
  <div class="cart-notification-wrapper{% if desktop_menu_type != 'drawer' %} page-width{% endif %}">
    <div
      id="cart-notification"
      class="cart-notification focus-inset"
      aria-modal="true"
      aria-label="Item added to your bag"
      role="dialog"
      tabindex="-1"
    >
      <div class="cl cl-notif">
        <div class="notif-head">
          <div class="notif-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          </div>
          <h2 class="notif-h">Added to your bag</h2>
          <button
            type="button"
            class="icbtn cart-notification__close"
            aria-label="Close"
          >
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path></svg>
          </button>
        </div>
        <div id="cart-notification-product" class="ci"></div>
        <div class="notif-links">
          <a href="{{ routes.cart_url }}" id="cart-notification-button" class="btn btn-fill w100">
            View my bag
          </a>
          <button type="button" class="notif-cont">Continue shopping</button>
        </div>
      </div>
    </div>
  </div>
</cart-notification>
{% style %}
  .cart-notification {
    display: none;
  }
{% endstyle %}
